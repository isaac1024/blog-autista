<?xml version="1.0" encoding="UTF-8" ?>
<ruleset name="blog-autista"
         xmlns="https://phpmd.org/xml/ruleset/1.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://phpmd.org/xml/ruleset/1.0.0 https://phpmd.org/xml/ruleset_xml_schema_1.0.0.xsd">
    <description>Complexity, size, coupling, naming and clean-code guardrails.</description>

    <!-- Code size: keep methods and classes small. -->
    <rule ref="rulesets/codesize.xml/CyclomaticComplexity">
        <properties>
            <property name="maximum" value="10"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/NPathComplexity">
        <properties>
            <property name="maximum" value="200"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveMethodLength">
        <properties>
            <property name="maximum" value="60"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveClassLength">
        <properties>
            <property name="maximum" value="500"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveParameterList">
        <properties>
            <property name="maximum" value="6"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/TooManyMethods">
        <properties>
            <property name="maximum" value="25"/>
        </properties>
    </rule>
    <rule ref="rulesets/codesize.xml/ExcessiveClassComplexity">
        <properties>
            <property name="maximum" value="50"/>
        </properties>
    </rule>

    <!-- Design: prefer composition, low coupling and no debug leftovers. -->
    <rule ref="rulesets/design.xml/CouplingBetweenObjects">
        <properties>
            <property name="maximum" value="20"/>
        </properties>
    </rule>
    <rule ref="rulesets/design.xml/DepthOfInheritance">
        <properties>
            <property name="maximum" value="4"/>
        </properties>
    </rule>
    <rule ref="rulesets/design.xml/NumberOfChildren">
        <properties>
            <property name="maximum" value="15"/>
        </properties>
    </rule>
    <rule ref="rulesets/design.xml/EmptyCatchBlock"/>
    <rule ref="rulesets/design.xml/DevelopmentCodeFragment">
        <properties>
            <property name="unwanted-functions"
                      value="var_dump,print_r,debug_zval_dump,debug_print_backtrace,dump,dd"/>
        </properties>
    </rule>
    <rule ref="rulesets/design.xml/ExitExpression"/>
    <rule ref="rulesets/design.xml/EvalExpression"/>
    <rule ref="rulesets/design.xml/GotoStatement"/>
    <rule ref="rulesets/design.xml/CountInLoopExpression"/>

    <!-- Clean code: no flag arguments, no assignments in conditions, no @. -->
    <rule ref="rulesets/cleancode.xml/BooleanArgumentFlag"/>
    <rule ref="rulesets/cleancode.xml/IfStatementAssignment"/>
    <rule ref="rulesets/cleancode.xml/ErrorControlOperator"/>
    <rule ref="rulesets/cleancode.xml/DuplicatedArrayKey"/>

    <!-- Naming: meaningful, explicit and consistent names. -->
    <rule ref="rulesets/naming.xml/LongClassName">
        <properties>
            <property name="maximum" value="40"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/ShortClassName">
        <properties>
            <property name="minimum" value="3"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/ShortVariable">
        <properties>
            <property name="minimum" value="3"/>
            <property name="exceptions" value="id,db,em"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/LongVariable">
        <properties>
            <property name="maximum" value="25"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/ShortMethodName">
        <properties>
            <property name="minimum" value="3"/>
            <property name="exceptions" value="id,up,down"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/LongMethodName">
        <properties>
            <property name="maximum" value="40"/>
        </properties>
    </rule>
    <rule ref="rulesets/naming.xml/ConstantNamingConventions"/>
    <rule ref="rulesets/naming.xml/BooleanGetMethodName"/>
</ruleset>
