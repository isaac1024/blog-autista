# npm installs the tools of development only (linters, tests, Lighthouse),
# never what the site runs, which comes through the import map.
#
# No package runs its own scripts on install: one compromised would run
# code on the machine, where the secrets of production may be. The only
# one that has a script, vnu-jar, downloads a Java that ui:check doesn't
# use (it runs the vnu.jar of the package with the Java of the system).
ignore-scripts=true
# Nor installs a version published less than a day ago: compromised
# versions are usually found and pulled within hours.
min-release-age=1
