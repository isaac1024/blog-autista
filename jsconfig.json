{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@symfony/stimulus-bundle": [
        "./vendor/symfony/stimulus-bundle/assets/dist/loader"
      ]
    }
  },
  "include": [
    "assets/**/*.js",
    "assets/**/*.d.ts"
  ]
}
