{% extends 'base.html.twig' %}

{% block title %}{{ 'cms.login.title'|trans }} · {{ 'cms.login.brand'|trans }}{% endblock %}

{% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('styles/login.css') }}">
{% endblock %}

{% block body %}
    <main class="login">
        <section class="login-panel" aria-labelledby="login-title">
            <div class="login-panel__inner">
                <header class="login-header">
                    <p class="login-eyebrow">
                        <picture class="login-eyebrow__picture">
                            <source srcset="{{ asset('images/logo-dark.svg') }}" media="(prefers-color-scheme: dark)" type="image/svg+xml">
                            <img class="login-eyebrow__mark" src="{{ asset('images/logo.svg') }}" width="24" height="24" alt="" aria-hidden="true">
                        </picture>
                        <span>{{ 'cms.login.brand'|trans }}</span>
                    </p>
                    <h1 class="login-title" id="login-title">{{ 'cms.login.title'|trans }}</h1>
                    <p class="login-subtitle">{{ 'cms.login.subtitle'|trans }}</p>
                </header>

{% if error %}
                <p class="alert" role="alert"><strong>{{ 'cms.login.error'|trans }}</strong> {{ error.messageKey|trans(error.messageData, 'security') }}</p>
{% endif %}

                <form class="login-form" method="post" action="{{ path('cms_login_check') }}">
                    <div class="field">
                        <label class="field-label" for="username">{{ 'cms.login.username'|trans }}</label>
                        <input class="field-input" type="text" id="username" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus>
                    </div>

                    <div class="field">
                        <label class="field-label" for="password">{{ 'cms.login.password'|trans }}</label>
                        <input class="field-input" type="password" id="password" name="_password" autocomplete="current-password" required>
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <button class="button" type="submit">{{ 'cms.login.submit'|trans }}</button>
                </form>
            </div>
        </section>
    </main>
{% endblock %}
