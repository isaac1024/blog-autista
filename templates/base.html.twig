<!DOCTYPE html>
<html lang="{% block lang %}{{ app.locale }}{% endblock %}" class="h-full">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="color-scheme" content="light dark">
        <meta name="theme-color" content="#f6f5f9" media="(prefers-color-scheme: light)">
        <meta name="theme-color" content="#1b1a20" media="(prefers-color-scheme: dark)">
        <title>{% block title %}Welcome!{% endblock %}</title>
{% block meta %}{% endblock %}
        {# The SVG follows the system theme; /favicon.ico stays at the root for what asks for it there. #}
        <link rel="icon" href="{{ asset('images/favicon.svg') }}" type="image/svg+xml">
        <link rel="apple-touch-icon" href="{{ asset('images/apple-touch-icon.png') }}">
        <link rel="preload" href="{{ asset('fonts/atkinson-hyperlegible-next-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
        {# Built by the Tailwind bundle and served by AssetMapper under a versioned URL, so browsers never keep a stale copy. #}
        <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {# The reader's text size and theme, set before the page paints. #}
        <script src="{{ asset('reading_apply.js') }}"></script>
{% block stylesheets %}{% endblock %}
{% block javascripts %}{% endblock %}
{# Layouts that need JavaScript fill these blocks. #}
{% block importmap %}{% endblock %}
        {# The panel that changes them, after any import map: a module loaded before one would void it. #}
        <script type="module" src="{{ asset('reading.js') }}"></script>
    </head>
    <body class="flex min-h-dvh flex-col bg-bg font-sans text-base leading-base tracking-base text-text [word-spacing:0.06em]">
{% block body %}{% endblock %}
    </body>
</html>
