<nav class="m-0 grid gap-2 border-t border-divider pt-4" aria-labelledby="post-tags-title">
    <h2 class="m-0 text-[1rem] font-bold" id="post-tags-title">{{ 'site.post.tags'|trans }}</h2>
    <ul class="m-0 flex list-none flex-wrap gap-2 p-0">
{% for tag in tags %}
        <li><a class="inline-flex min-h-11 items-center rounded-control border-2 border-border px-3 font-bold text-text no-underline hover:border-accent hover:text-accent forced-colors:border-[LinkText]" href="{{ tag.url }}">{{ tag.name }}</a></li>
{% endfor %}
    </ul>
</nav>
