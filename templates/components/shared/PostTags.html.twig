{# The tags of the post, under a faint line, each a link to its page. #}
<nav class="m-0 grid gap-2 border-t border-divider pt-6" aria-labelledby="post-tags-title">
    <h2 class="m-0 text-base font-normal text-muted" id="post-tags-title">{{ 'site.post.tags'|trans }}</h2>
    <ul class="m-0 flex list-none flex-wrap gap-x-6 gap-y-1 p-0">
{% for tag in tags %}
        <li><a class="inline-flex min-h-11 items-center text-accent underline decoration-[0.06em] underline-offset-[0.2em] hover:text-accent-strong hover:decoration-[0.12em]" href="{{ tag.url }}">{{ tag.name }}</a></li>
{% endfor %}
    </ul>
</nav>
