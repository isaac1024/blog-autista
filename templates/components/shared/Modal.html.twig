{% import 'shared/render_component.html.twig' as renderer %}
<button class="min-h-11 cursor-pointer border-2 border-transparent bg-accent px-4 py-2.5 text-[1rem] font-bold text-on-accent transition-colors duration-150 hover:bg-accent-strong active:translate-y-px motion-reduce:transition-none motion-reduce:active:translate-y-0 forced-colors:border-[ButtonText]" type="button" data-dialog-open="{{ id }}" aria-haspopup="dialog">{{ trigger }}</button>
<dialog id="{{ id }}" class="m-auto max-h-[calc(100dvh_-_2rem)] w-[calc(100%_-_2rem)] max-w-[34rem] overflow-y-auto border-2 border-border bg-surface p-0 text-text shadow-card backdrop:bg-black/60" aria-labelledby="{{ id }}-title" data-dialog>
    <div class="flex flex-col gap-6 p-[clamp(1.25rem,4vw,2rem)]">
        <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
                <h2 class="m-0 text-[1.5rem] font-bold leading-tight" id="{{ id }}-title">{{ title }}</h2>
{% if description %}
                <p class="mt-2 text-[1rem] text-muted">{{ description }}</p>
{% endif %}
            </div>
            <form method="dialog">
                <button class="flex h-11 w-11 flex-none cursor-pointer items-center justify-center border-2 border-border bg-surface text-text hover:border-accent hover:text-accent" type="submit">
                    <span class="sr-only">{{ 'ui.close'|trans }}</span>
                    <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                </button>
            </form>
        </div>
{% for child in children %}
        {{ renderer.render(child) }}
{% endfor %}
    </div>
</dialog>
<script src="{{ asset('scripts/dialog.js') }}" defer></script>
