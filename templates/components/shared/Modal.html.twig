{% import 'shared/render_component.html.twig' as renderer %}
<twig:Shared:ModalTrigger :target="id" :label="trigger" />
<dialog id="{{ id }}" class="m-auto max-h-[calc(100dvh_-_2rem)] w-[calc(100%_-_2rem)] max-w-[34rem] overflow-y-auto rounded-card border-2 border-border bg-surface p-0 text-text shadow-card backdrop:bg-black/60" aria-labelledby="{{ id }}-title" closedby="any">
    <div class="flex flex-col gap-6 p-[clamp(1.25rem,4vw,2rem)]">
        <div class="flex items-start gap-4">
            <div class="min-w-0 flex-1">
                <h2 class="m-0 text-[1.5rem] font-bold leading-tight" id="{{ id }}-title">{{ title }}</h2>
{% if description %}
                <p class="mt-2 text-[1rem] text-muted">{{ description }}</p>
{% endif %}
            </div>
            <button class="flex h-11 w-11 flex-none cursor-pointer items-center justify-center rounded-control border-2 border-border bg-surface text-text hover:border-accent hover:text-accent forced-colors:border-[ButtonText]" type="button" commandfor="{{ id }}" command="close">
                <span class="sr-only">{{ 'ui.close'|trans }}</span>
                <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M6 6l12 12M18 6L6 18" />
                </svg>
            </button>
        </div>
{% for child in children %}
        {{ renderer.render(child) }}
{% endfor %}
    </div>
</dialog>
