{#
    Each day has an equal slot across the plot; its column, square at both
    ends as every corner of the blog, is at most 24px wide and leaves the rest
    of the slot as air, never less than 2px of it. Text keeps the text
    colours; only the columns wear the chart colour.
#}
<figure class="m-0 flex flex-col gap-3" aria-labelledby="{{ this.headingId }}">
    <figcaption class="text-[1rem] font-bold" id="{{ this.headingId }}">{{ title }}</figcaption>
    <div class="flex gap-2" aria-hidden="true">
        <div class="flex h-40 w-max flex-col justify-between text-right text-[0.875rem] leading-none tabular-nums text-muted">
            <span>{{ this.peakShown }}</span>
            <span>0</span>
        </div>
        <div class="flex min-w-0 flex-1 flex-col gap-1">
            <div class="flex h-40 items-end border-b border-t border-divider">
{% for point in points %}
                <div class="flex h-full min-w-0 flex-1 items-end justify-center px-px hover:bg-accent-soft" title="{{ point.label }}: {{ point.shown }} {{ valueLabel }}">
                    <div class="w-full max-w-6 bg-chart forced-colors:bg-[CanvasText]" style="height: {{ this.height(point.value) }}%"></div>
                </div>
{% endfor %}
            </div>
            <div class="flex justify-between text-[0.875rem] text-muted">
                <span>{{ (points|first).label }}</span>
                <span>{{ (points|last).label }}</span>
            </div>
        </div>
    </div>
    <details class="text-[1rem]">
        <summary class="min-h-11 cursor-pointer py-2 text-accent hover:text-accent-strong">{{ tableLabel }}</summary>
        <div class="max-h-80 overflow-y-auto focus-visible:outline-3 focus-visible:outline-offset-2 focus-visible:outline-focus" tabindex="0" role="region" aria-label="{{ title }}">
            <table class="w-full border-collapse">
                <thead>
                    <tr>
                        <th class="border-b border-divider py-2 text-left" scope="col">{{ columnLabel }}</th>
                        <th class="border-b border-divider py-2 text-right" scope="col">{{ valueLabel|capitalize }}</th>
                    </tr>
                </thead>
                <tbody>
{% for point in points %}
                    <tr>
                        <th class="border-b border-divider py-2 text-left font-normal" scope="row">{{ point.label }}</th>
                        <td class="border-b border-divider py-2 text-right tabular-nums">{{ point.shown }}</td>
                    </tr>
{% endfor %}
                </tbody>
            </table>
        </div>
    </details>
</figure>
