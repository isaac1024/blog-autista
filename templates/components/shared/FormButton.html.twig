{% set button %}
<button class="min-h-12 cursor-pointer rounded-control border border-transparent px-5 py-3 text-base font-bold transition-colors duration-150 {{ fullWidth ? 'w-full' : 'w-full sm:w-auto' }} {{ variant == 'danger' ? 'bg-danger text-on-danger hover:bg-danger-strong' : variant == 'secondary' ? 'border-border! bg-bg text-text hover:border-accent! hover:text-accent' : 'bg-accent text-on-accent hover:bg-accent-strong' }} active:translate-y-px aria-disabled:cursor-not-allowed aria-disabled:opacity-60 aria-disabled:active:translate-y-0 motion-reduce:transition-none motion-reduce:active:translate-y-0 forced-colors:border-[ButtonText] forced-colors:aria-disabled:text-[GrayText]" type="{{ type }}"{% if form %} form="{{ form }}"{% endif %}{% if waitsFor %} aria-describedby="{{ waitsFor }}-unsaved" data-unsaved-changes-target="button" data-action="unsaved-changes#hold"{% endif %}>{{ label }}</button>
{% endset %}
{% if waitsFor %}
{# display: contents keeps the hint and the button laid out as siblings of the bar they sit in. #}
<span class="contents" data-controller="unsaved-changes" data-unsaved-changes-form-value="{{ waitsFor }}" data-action="input@document->unsaved-changes#check change@document->unsaved-changes#check">
    <span class="basis-full text-[1rem] text-muted sm:basis-auto" id="{{ waitsFor }}-unsaved" role="status" data-unsaved-changes-target="hint" hidden>{{ waitingHint }}</span>
    {{ button }}
</span>
{% else %}
{{ button }}
{% endif %}
