{#
    Hidden without scripts, since only reading.js can change the settings;
    with them, shown from the first paint, as the script of the head marks
    the page before it is painted, so nothing beside it moves. The button is
    named by what it shows, "Aa" and, on wider screens, its short word, so
    whoever speaks to the page says what they see; the word stays for screen
    readers on narrow ones. The panel closes with Escape or a click
    elsewhere.
    It hangs from the bar it is in, never from the button, so it never runs
    off the screen, whatever the size of the text: on narrow screens it
    takes the width of the bar within its margins; from sm up, at the end of
    a header, it lines up with the end of the bar's content; at the start of
    the CMS's sidebar, from md up, it opens under the button. A panel taller
    than the screen goes on below it, as far as the page scrolls.
#}
<div{{ attributes.defaults({class: 'hidden scripted:block' ~ (align == 'start' ? ' md:relative')}) }} data-reading>
    <button class="flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-2 border-0 bg-transparent px-2 font-bold text-text hover:text-accent aria-expanded:bg-surface" type="button" aria-expanded="false" aria-controls="reading-settings" data-reading-toggle>
        <span>Aa</span>
        <span class="sr-only font-normal md:not-sr-only">{{ 'ui.reading.short'|trans }}</span>
    </button>
    <div class="absolute top-full z-20 grid gap-5 bg-surface p-[max(1rem,min(1.5rem,6.4vw))] text-[1.0625rem] leading-snug shadow-card sm:left-auto sm:w-[min(21rem,calc(100vw-2rem))] forced-colors:border forced-colors:border-[CanvasText] {{ align == 'start' ? 'inset-x-[clamp(1rem,4vw,1.5rem)] md:right-auto md:left-0' : 'right-[max(clamp(0.5rem,3vw,2rem),calc((100%-72rem)/2+clamp(0.5rem,3vw,2rem)))] left-[clamp(1rem,4vw,2rem)]' }}" id="reading-settings" role="group" aria-labelledby="reading-settings-title" data-reading-panel hidden>
        <p class="m-0 text-lg font-bold" id="reading-settings-title">{{ 'ui.reading.toggle'|trans }}</p>
        <div class="grid gap-2">
            <p class="m-0" id="reading-settings-size">{{ 'ui.reading.size'|trans }}</p>
            <div class="flex flex-wrap items-center gap-2" role="group" aria-labelledby="reading-settings-size">
                <button class="size-12 flex-none cursor-pointer border border-border bg-bg text-[1.375rem] text-text hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-50" type="button" aria-label="{{ 'ui.reading.smaller'|trans }}" data-reading-size="smaller">−</button>
                <output class="grow text-center font-bold" aria-live="polite" data-reading-size-value>100 %</output>
                <button class="size-12 flex-none cursor-pointer border border-border bg-bg text-[1.375rem] text-text hover:border-accent hover:text-accent disabled:cursor-not-allowed disabled:opacity-50" type="button" aria-label="{{ 'ui.reading.bigger'|trans }}" data-reading-size="bigger">+</button>
            </div>
        </div>
        <fieldset class="m-0 grid gap-2 border-0 p-0">
            <legend class="mb-2 p-0">{{ 'ui.reading.theme'|trans }}</legend>
            <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,5.5rem),1fr))] gap-1.5">
{% for theme in ['system', 'light', 'dark'] %}
                <label class="relative grid min-h-12 cursor-pointer place-items-center border border-border bg-bg px-1 text-center text-text has-checked:border-accent has-checked:bg-accent has-checked:font-bold has-checked:text-on-accent forced-colors:has-checked:border-4 has-focus-visible:outline-3 has-focus-visible:outline-offset-3 has-focus-visible:outline-focus">
                    <input class="sr-only" type="radio" name="reading-theme" value="{{ theme }}"{% if theme == 'system' %} checked{% endif %}>
                    {{ ('ui.reading.theme_' ~ theme)|trans }}
                </label>
{% endfor %}
            </div>
        </fieldset>
        <p class="m-0 text-base text-muted">{{ 'ui.reading.kept'|trans }}</p>
    </div>
</div>
