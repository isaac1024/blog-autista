{# Shown 10rem wide, so the browser takes the copy of 200 or 400 pixels. #}
<img class="block h-40 w-40 border border-divider bg-bg object-cover forced-colors:border-[CanvasText]" src="{{ src }}"{% if srcset is not empty %} srcset="{{ srcset }}" sizes="10rem"{% endif %} width="{{ size }}" height="{{ size }}" alt="{{ alt }}" decoding="async">
