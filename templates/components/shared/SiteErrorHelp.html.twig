{# What to do next, from the search to the home page. #}
<div class="grid grid-cols-1 gap-10">
{% if searchUrl %}
    <div class="grid min-w-0 grid-cols-1 gap-2">
        <twig:Shared:SearchForm :action="searchUrl" :name="searchName" id="site-error-search" :label="'site.search.label'|trans" :submit="'site.search.submit'|trans" :value="words" />
{% if words %}
        <p class="m-0 text-base text-muted">{{ 'site.error_help.words'|trans }}</p>
{% endif %}
    </div>
{% endif %}
{% if latest is not empty %}
    <section class="grid gap-6" aria-labelledby="site-error-latest">
        <h2 class="m-0 text-[1.5625rem] leading-snug font-semibold" id="site-error-latest">{{ 'site.error_help.latest'|trans }}</h2>
        <twig:Shared:PostCards :cards="latest" :headingLevel="3" :lead="true" />
    </section>
{% endif %}
    <twig:Shared:ButtonLink :url="homeUrl" :label="'site.home'|trans" />
</div>
