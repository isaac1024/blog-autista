{# Only painted when there is a page to go to: a single page needs no navigation. #}
{% if previousUrl or nextUrl %}
<nav class="flex flex-wrap items-center justify-between gap-4 border-t border-divider pt-8" aria-label="{{ label }}">
{% if previousUrl %}
    <a class="inline-flex min-h-12 items-center justify-center border border-border px-5 py-2.5 text-base font-bold text-text no-underline hover:border-accent hover:text-accent forced-colors:border-[LinkText]" href="{{ previousUrl }}" rel="prev">{{ previousLabel }}</a>
{% else %}
    <span></span>
{% endif %}
    <span class="text-base text-muted" aria-current="page">{{ current }}</span>
{% if nextUrl %}
    <a class="inline-flex min-h-12 items-center justify-center border border-border px-5 py-2.5 text-base font-bold text-text no-underline hover:border-accent hover:text-accent forced-colors:border-[LinkText]" href="{{ nextUrl }}" rel="next">{{ nextLabel }}</a>
{% else %}
    <span></span>
{% endif %}
</nav>
{% endif %}
