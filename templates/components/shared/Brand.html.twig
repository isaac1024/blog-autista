<div{{ attributes.defaults({class: 'm-0 inline-flex items-center gap-2.5 text-[1.125rem] font-bold tracking-[0.01em]'}) }}>
    <twig:Shared:Logo />
{% if homeUrl %}
    <a class="text-inherit no-underline hover:underline hover:decoration-[0.08em] hover:underline-offset-[0.18em]" href="{{ homeUrl }}">{{ brand }}</a>
{% else %}
    <span>{{ brand }}</span>
{% endif %}
</div>
