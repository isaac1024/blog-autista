{#
    What comes from another site sits on a panel of its own, with a line on
    top that says what it is and where it comes from, with a link to open it
    there; nothing of the author's takes a panel, so the two never mix up.

    The facade keeps the room of what it embeds from the start, so nothing
    moves when it loads: a proportion of its width for a video, the height
    of the player for an audio, and, for a post, the height of what it says,
    which the frame then takes as its own. Nothing of the provider loads
    until the reader agrees, in the notice that takes the place of the
    facade, without a modal, and grows past its room when it needs to.
    Without scripts, the link on top leads to the original, and the buttons
    stay hidden.
#}
{% set frame = {
    landscape: 'aspect-video',
    portrait: 'mx-auto aspect-[9/16] w-full max-w-[22rem]',
    compact: 'h-[152px]',
    tall: 'h-[352px]',
    reported: '',
}[space] %}
{% set audio = space in ['compact', 'tall'] %}
<figure class="external-embed m-0 -mx-[clamp(1rem,4vw,2rem)] grid bg-surface sm:mx-0 forced-colors:border forced-colors:border-[CanvasText]" data-external-embed data-provider="{{ provider }}" data-src="{{ embedUrl }}" data-origin="{{ frameOrigin }}" data-space="{{ space }}" data-title="{{ 'content.external.frame_title'|trans({'%title%': title, '%provider%': providerLabel}) }}">
    <div class="flex items-center gap-2.5 px-[clamp(1rem,4vw,1.25rem)] py-3 text-base leading-snug">
        <svg class="size-5 flex-none text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if kind == 'video' %}
            <rect x="3" y="5" width="18" height="14"/><path d="M10 9.5v5l4.5-2.5z" fill="currentColor"/>
{% elseif kind == 'audio' %}
            <path d="M4 15v-3a8 8 0 0 1 16 0v3"/><rect x="3" y="14" width="4" height="6"/><rect x="17" y="14" width="4" height="6"/>
{% else %}
            <path d="M4 5h16v11H9l-5 4z"/>
{% endif %}
        </svg>
        <p class="m-0 grow"><span class="font-bold">{{ ('content.external.label.' ~ kind)|trans }}</span> {{ 'content.external.provided_by'|trans({'%provider%': providerLabel}) }}{% if show %}<span class="sr-only">, </span><span class="block text-muted" lang="{{ language }}">{{ show }}</span>{% endif %}</p>
        <a class="inline-flex min-h-11 flex-none items-center text-accent underline decoration-[0.06em] underline-offset-[0.2em] hover:text-accent-strong hover:decoration-[0.12em]" href="{{ url }}" rel="external">{{ 'content.external.open_short'|trans }}<span class="sr-only"> {{ 'content.external.open_where'|trans({'%provider%': providerLabel, '%title%': title}) }}</span></a>
    </div>
    <div class="external-embed-frame relative grid {{ frame }}{% if post %} mx-3{% endif %}" data-external-frame>
        <div class="col-start-1 row-start-1 grid min-h-0" data-external-facade>
{% if post %}
            <blockquote class="m-0 grid content-start gap-3 bg-bg p-4" cite="{{ url }}" lang="{{ language }}">
                <p class="m-0 leading-snug"><span class="font-bold">{{ post.author }}</span><br><span class="text-base text-muted">{{ post.handle }}</span></p>
{% for paragraph in post.paragraphs %}
                <p class="m-0 break-words">{% for line in paragraph %}{{ line }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
{% endfor %}
{% if post.withMedia %}
                <p class="m-0 text-base text-muted">{{ 'content.external.with_media'|trans({'%provider%': providerLabel}) }}</p>
{% endif %}
{% if post.date %}
                <p class="m-0 text-base text-muted"><time datetime="{{ post.day }}">{{ post.date }}</time></p>
{% endif %}
            </blockquote>
{% elseif audio %}
            {# An audio: its cover beside its title, and the button that plays it. #}
            <div class="col-start-1 row-start-1 grid min-h-0 grid-cols-[auto_1fr] content-center items-center gap-4 px-[clamp(1rem,4vw,1.25rem)] pb-4">
{% if image %}
                <img class="block size-24 bg-bg object-cover" src="{{ image.src }}" srcset="{{ image.srcset }}" sizes="6rem" width="{{ image.width }}" height="{{ image.height }}" alt="" loading="lazy" decoding="async">
{% endif %}
                <div class="grid min-w-0 gap-2 {{ image ? '' : 'col-span-2' }}">
                    <p class="m-0 leading-snug font-bold text-balance" lang="{{ language }}">{{ title }}</p>
                    <button class="grid size-11 cursor-pointer place-items-center border-0 bg-accent text-on-accent hover:bg-accent-strong forced-colors:border forced-colors:border-[ButtonText]" type="button" aria-controls="{{ id }}" aria-label="{{ 'content.external.play'|trans({'%title%': title, '%provider%': providerLabel}) }}" data-external-play hidden>
                        <svg class="size-5" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
                    </button>
                </div>
            </div>
{% else %}
{% if image %}
            <img class="col-start-1 row-start-1 block h-full min-h-0 w-full bg-bg object-cover" src="{{ image.src }}" srcset="{{ image.srcset }}" sizes="(min-width: 44rem) 42rem, 100vw" width="{{ image.width }}" height="{{ image.height }}" alt="" loading="lazy" decoding="async">
{% else %}
            {# Without a picture of its own, a calm ground; its title is under it, as for any video. #}
            <div class="col-start-1 row-start-1 bg-accent-soft"></div>
{% endif %}
            {# The whole facade plays it, once the script can: without one, the link on top leads to the original. #}
            <button class="group col-start-1 row-start-1 grid cursor-pointer place-items-center border-0 bg-transparent p-0" type="button" aria-controls="{{ id }}" aria-label="{{ 'content.external.play'|trans({'%title%': title, '%provider%': providerLabel}) }}" data-external-play hidden>
                <span class="grid size-16 place-items-center bg-accent text-on-accent group-hover:bg-accent-strong forced-colors:border-2 forced-colors:border-[ButtonText]">
                    <svg class="size-7" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
                </span>
            </button>
{% endif %}
        </div>
        <div class="col-start-1 row-start-1 grid content-center gap-3 bg-surface px-[clamp(1rem,4vw,1.25rem)] py-5" id="{{ id }}" role="group" aria-labelledby="{{ id }}-title" data-external-notice hidden>
            <p class="m-0 text-lg font-bold" id="{{ id }}-title" tabindex="-1" data-external-notice-title>{{ 'content.external.notice.title'|trans({'%provider%': providerLabel}) }}</p>
            <p class="m-0 text-base">{{ 'content.external.notice.message'|trans({'%provider%': providerLabel}) }}</p>
            <p class="m-0 flex flex-wrap gap-x-6 text-base">
{% if cookiesUrl %}
                <a class="text-accent underline decoration-[0.06em] underline-offset-[0.2em]" href="{{ cookiesUrl }}">{{ 'content.external.notice.cookies'|trans }}</a>
{% endif %}
                <a class="text-accent underline decoration-[0.06em] underline-offset-[0.2em]" href="{{ privacyUrl }}" rel="external noopener">{{ 'content.external.notice.privacy'|trans({'%provider%': providerLabel}) }}</a>
            </p>
            <div class="flex flex-wrap gap-2.5">
                <button class="min-h-12 cursor-pointer border-0 bg-accent px-5 font-bold text-on-accent hover:bg-accent-strong forced-colors:border forced-colors:border-[ButtonText]" type="button" data-external-accept>{{ 'content.external.notice.accept'|trans }}</button>
                <button class="min-h-12 cursor-pointer border border-border bg-bg px-5 font-bold text-text hover:border-accent hover:text-accent forced-colors:border-[ButtonText]" type="button" data-external-cancel>{{ 'content.external.notice.cancel'|trans }}</button>
            </div>
        </div>
    </div>
    <figcaption class="grid gap-1.5 px-[clamp(1rem,4vw,1.25rem)] pt-3 pb-4 text-base">
{% if not audio and not post %}
        <p class="m-0 leading-snug font-bold text-balance text-text" lang="{{ language }}">{{ title }}</p>
{% endif %}
        {# Two lines are kept for the button whichever it says, so changing it moves nothing. #}
        <p class="m-0 min-h-[3.25rem] sm:min-h-[1.625rem]">
            <button class="cursor-pointer border-0 bg-transparent p-0 text-left text-accent underline decoration-[0.06em] underline-offset-[0.2em] hover:text-accent-strong hover:decoration-[0.12em]" type="button" aria-controls="{{ id }}" data-external-load hidden>{{ 'content.external.load'|trans({'%provider%': providerLabel}) }}</button>
            <button class="cursor-pointer border-0 bg-transparent p-0 text-left text-accent underline decoration-[0.06em] underline-offset-[0.2em] hover:text-accent-strong hover:decoration-[0.12em]" type="button" data-external-forget hidden>{{ 'content.external.forget'|trans({'%provider%': providerLabel}) }}</button>
        </p>
    </figcaption>
</figure>
