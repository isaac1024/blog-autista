{% import 'shared/render_component.html.twig' as renderer %}
{% if variant == 'disclosure' %}
<details class="group rounded-card border border-divider bg-surface shadow-panel forced-colors:border-[CanvasText]">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-card p-[clamp(1.25rem,3vw,1.75rem)] hover:text-accent [&::-webkit-details-marker]:hidden">
        <span class="grid gap-1">
            <span class="text-xl font-bold leading-tight text-balance" role="heading" aria-level="2">{{ title }}</span>
{% if description %}
            <span class="text-[1rem] font-normal text-muted">{{ description }}</span>
{% endif %}
        </span>
        <svg class="h-5 w-5 flex-none transition-transform group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 7.5l5 5 5-5" />
        </svg>
    </summary>
    <div class="flex flex-col gap-5 border-t border-divider p-[clamp(1.25rem,3vw,1.75rem)]">
{% for child in children %}
        {{ renderer.render(child) }}
{% endfor %}
    </div>
</details>
{% else %}
<section class="flex flex-col gap-5 rounded-card border border-divider bg-surface p-[clamp(1.25rem,3vw,1.75rem)] shadow-panel forced-colors:border-[CanvasText]"{% if title %} aria-labelledby="{{ this.headingId }}"{% endif %}>
{% if title %}
    <div class="flex flex-col gap-1">
        <h2 class="m-0 text-xl font-bold leading-tight text-balance" id="{{ this.headingId }}">{{ title }}</h2>
{% if description %}
        <p class="m-0 text-[1rem] text-muted">{{ description }}</p>
{% endif %}
    </div>
{% endif %}
{% for child in children %}
    {{ renderer.render(child) }}
{% endfor %}
</section>
{% endif %}
