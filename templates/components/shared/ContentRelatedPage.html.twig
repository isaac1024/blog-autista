{#
    The whole card is the link, so it is one stop for the keyboard and its
    name says what it is before the title: "Related content: <title>". The
    title is no heading, so the outline of the page stays its own.
#}
<a class="group flex flex-col gap-2 rounded-card border-2 border-border bg-surface p-5 text-text no-underline transition-colors duration-150 hover:border-accent motion-reduce:transition-none forced-colors:border-[LinkText]" href="{{ url }}">
    <span class="text-[1rem] font-bold text-muted">{{ 'content.related_page.label'|trans }}<span class="sr-only">:</span></span>
    <span class="text-xl font-bold leading-tight text-balance text-accent underline decoration-[0.1em] underline-offset-[0.15em] group-hover:text-accent-strong">{{ title }}</span>
</a>
