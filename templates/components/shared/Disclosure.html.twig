{% import 'shared/render_component.html.twig' as renderer %}
<details class="group rounded-control border-2 border-border bg-surface forced-colors:border-[ButtonText]">
    <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-2 px-4 py-2 font-bold hover:text-accent [&::-webkit-details-marker]:hidden">
        <span>{{ summary }}</span>
        <svg class="h-5 w-5 flex-none transition-transform group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 7.5l5 5 5-5" />
        </svg>
    </summary>
    <div class="grid gap-4 border-t border-divider p-4">
{% for child in children %}
        {{ renderer.render(child) }}
{% endfor %}
    </div>
</details>
