{#
    The whole card is the link, so it is one stop for the keyboard and its
    name says what it is and that it leaves the blog before the title. The
    title is no heading, so the outline of the page stays its own.
#}
<a class="group grid gap-3 rounded-card border-2 border-border bg-surface p-5 text-text no-underline transition-colors duration-150 hover:border-accent motion-reduce:transition-none forced-colors:border-[LinkText]" href="{{ url }}" rel="external">
{% if image %}
    <img class="block h-auto w-full bg-bg" src="{{ image.src }}" srcset="{{ image.srcset }}" sizes="(min-width: 44rem) 42rem, 100vw" width="{{ image.width }}" height="{{ image.height }}" alt="" loading="lazy" decoding="async">
{% endif %}
    <span class="text-[1rem] font-bold text-muted">{{ ('content.external.label.' ~ kind)|trans }}<span class="sr-only">, {{ 'content.external.leaves'|trans }}:</span></span>
    <span class="text-xl font-bold leading-tight text-balance text-accent underline decoration-[0.1em] underline-offset-[0.15em] group-hover:text-accent-strong" lang="{{ language }}">{{ title }}</span>
{% if summary %}
    <span lang="{{ language }}">{{ summary }}</span>
{% endif %}
{% if source is not empty %}
    <span class="text-[1rem] text-muted">{{ source|join(' · ') }}</span>
{% endif %}
</a>
