{#
    What the blog itself has to say elsewhere, on a panel as what comes from
    other sites does, so both read as content the text points to, told apart
    by the line on top: what it is, and where in the blog. The whole card is
    the link, so it is one stop for the keyboard, and its name says what it
    is before the title. The picture says nothing the title doesn't, so it
    has no alternative text. The title is no heading, so the outline of the
    page stays its own.
#}
<a class="group -mx-[clamp(1rem,4vw,2rem)] grid gap-3 bg-surface px-[clamp(1rem,4vw,1.25rem)] pt-3 pb-5 text-text no-underline sm:mx-0 forced-colors:border forced-colors:border-[LinkText]" href="{{ url }}">
    <span class="flex items-start gap-2.5 text-base leading-snug">
        <svg class="mt-px size-5 flex-none text-accent" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
{% if kind == 'post' %}
            <path d="M5 4h14v16H5z"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4"/>
{% elseif kind == 'section' %}
            <path d="M3 6h7l2 2h9v11H3z"/>
{% elseif kind == 'tag' %}
            <path d="M9 4 7 20M17 4l-2 16M4 9h16M3.5 15h16"/>
{% elseif kind == 'author' %}
            <circle cx="12" cy="8.5" r="3.5"/><path d="M5 20a7 7 0 0 1 14 0"/>
{% else %}
            <path d="M6 3h8l4 4v14H6z"/><path d="M14 3v4h4"/>
{% endif %}
        </svg>
        <span><span class="font-bold">{{ ('content.related.label.' ~ kind)|trans }}</span><span class="sr-only">:</span>{% if source is not empty %}<span class="block text-muted">{{ source|join(' · ') }}</span>{% endif %}</span>
    </span>
    <span class="grid items-start gap-4{{ image ? ' grid-cols-[auto_minmax(0,1fr)]' : '' }}">
{% if image %}
        <img class="block bg-bg object-cover {{ kind == 'author' ? 'size-16' : 'aspect-video w-28 sm:w-40' }}" src="{{ image.src }}" srcset="{{ image.srcset }}" sizes="10rem" width="{{ image.width }}" height="{{ image.height }}" alt=""{% if not lead %} loading="lazy" decoding="async"{% endif %}>
{% endif %}
        <span class="grid gap-1.5">
            <span class="text-xl leading-snug font-semibold text-balance text-accent underline decoration-[0.06em] underline-offset-[0.18em] group-hover:text-accent-strong group-hover:decoration-[0.12em]">{{ title }}</span>
{% if summary %}
            <span class="leading-normal">{{ summary }}</span>
{% endif %}
        </span>
    </span>
</a>
