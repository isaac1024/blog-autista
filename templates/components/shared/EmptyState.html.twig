{% import 'shared/render_component.html.twig' as renderer %}
<div class="flex flex-col items-center gap-4 rounded-card border border-divider bg-surface px-5 py-10 text-center shadow-panel sm:px-10 sm:py-14 forced-colors:border-[CanvasText]">
    <h2 class="m-0 text-xl font-bold leading-tight text-balance">{{ title }}</h2>
    <p class="m-0 max-w-[45ch] text-[1rem] text-muted">{{ message }}</p>
{% if children is not empty %}
    <div class="mt-2 flex flex-wrap justify-center gap-3">
{% for child in children %}
        {{ renderer.render(child) }}
{% endfor %}
    </div>
{% endif %}
</div>
