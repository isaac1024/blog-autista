{% if brand or links is not empty %}
<footer class="flex flex-col gap-4 border-t-2 border-border bg-surface px-[clamp(1rem,4vw,2rem)] py-6 text-muted">
{% if links is not empty %}
    <twig:Shared:Nav :label="'ui.footer_navigation'|trans" :links="links" />
{% endif %}
{% if brand %}
    <p class="m-0">© {{ year ?: 'now'|date('Y') }} {{ brand }}</p>
{% endif %}
</footer>
{% endif %}
