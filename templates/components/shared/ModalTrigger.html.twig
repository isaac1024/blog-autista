<button class="min-h-11 cursor-pointer rounded-control border px-4 py-2.5 text-[1rem] font-bold transition-colors duration-150 {{ variant == 'danger' ? 'border-danger bg-bg text-danger hover:bg-danger hover:text-on-danger' : variant == 'secondary' ? 'border-border bg-bg text-text hover:border-accent hover:text-accent' : 'border-transparent bg-accent text-on-accent hover:bg-accent-strong' }} active:translate-y-px motion-reduce:transition-none motion-reduce:active:translate-y-0 forced-colors:border-[ButtonText]" type="button" commandfor="{{ target }}" command="show-modal" aria-haspopup="dialog">{{ label }}</button>
