{#
    Writing first: nothing ever covers the text. Every control lives in one
    dock at the bottom, right above the form actions, the same on every
    screen, and only while editing.

    The frame stays hidden until the controller mounts the editor in it, so
    without JavaScript only the label and the notice show.
#}
{% macro icon(name) %}
<svg class="h-5 w-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if name == 'moveUp' %}
    <path d="M12 19V5M6 11l6-6 6 6" />
{% elseif name == 'moveDown' %}
    <path d="M12 5v14M6 13l6 6 6-6" />
{% elseif name == 'bold' %}
    <path d="M7 5h6a3.5 3.5 0 0 1 0 7H7zM7 12h7a3.5 3.5 0 0 1 0 7H7z" />
{% elseif name == 'insertLink' %}
    <path d="M10 13a5 5 0 0 0 7.1.1l2-2a5 5 0 0 0-7.1-7.1l-1.1 1.1" /><path d="M14 11a5 5 0 0 0-7.1-.1l-2 2A5 5 0 0 0 12 20l1.1-1.1" />
{% elseif name == 'insertImage' %}
    <rect x="3.5" y="4.5" width="17" height="15" rx="2" /><circle cx="9" cy="10" r="1.75" /><path d="M20.5 15.5l-5-5-9 9" />
{% elseif name == 'insertWidget' %}
    <rect x="3.5" y="5.5" width="17" height="13" rx="1.5" /><path d="M7 10h4M7 14h10" />
{% elseif name == 'insertTable' %}
    <rect x="3.5" y="4.5" width="17" height="15" rx="1.5" /><path d="M3.5 9.5h17M3.5 14.5h17M10 9.5v10" />
{% elseif name == 'undo' %}
    <path d="M9 14L4 9l5-5" /><path d="M4 9h10.5a5.5 5.5 0 0 1 0 11H11" />
{% elseif name == 'redo' %}
    <path d="M15 14l5-5-5-5" /><path d="M20 9H9.5a5.5 5.5 0 0 0 0 11H13" />
{% elseif name == 'addRowAfter' %}
    <rect x="3.5" y="3.5" width="17" height="11" rx="1.5" /><path d="M3.5 9h17M12 17v5M9.5 19.5h5" />
{% elseif name == 'addColumnAfter' %}
    <rect x="3.5" y="3.5" width="11" height="17" rx="1.5" /><path d="M9 3.5v17M17 12h5M19.5 9.5v5" />
{% elseif name == 'deleteRow' %}
    <rect x="3.5" y="3.5" width="17" height="11" rx="1.5" /><path d="M3.5 9h17M9.5 19.5h5" />
{% elseif name == 'deleteColumn' %}
    <rect x="3.5" y="3.5" width="11" height="17" rx="1.5" /><path d="M9 3.5v17M17 12h5" />
{% elseif name == 'deleteTable' %}
    <rect x="3.5" y="4.5" width="17" height="15" rx="1.5" /><path d="M9.5 9.5l5 5M14.5 9.5l-5 5" />
{% elseif name == 'outline' %}
    <path d="M4 6h16M8 12h12M8 18h12" />
{% endif %}
</svg>
{% endmacro %}
{% macro tooltip(label) %}
<span class="pointer-events-none absolute bottom-full left-1/2 z-30 mb-2 hidden -translate-x-1/2 whitespace-nowrap rounded-control bg-text px-2 py-1 text-[0.875rem] font-bold text-bg group-hover/button:block group-focus-visible/button:block" aria-hidden="true" data-role="tooltip">{{ label }}</span>
{% endmacro %}
{#
    A compact control: an icon with its name, which shows on hover and on
    focus, and which assistive technology reads in any case. Without an icon,
    the name itself shows.
#}
{% macro button(command, label, options = {}) %}
<button class="group/button relative inline-flex min-h-11 min-w-11 cursor-pointer items-center justify-center gap-1 rounded-control border-2 border-transparent bg-surface px-2 text-[1rem] font-bold text-text transition-colors duration-150 hover:border-border aria-pressed:border-accent aria-pressed:bg-accent aria-pressed:text-on-accent aria-disabled:cursor-not-allowed aria-disabled:text-muted aria-disabled:opacity-60 aria-disabled:hover:border-transparent motion-reduce:transition-none forced-colors:border-[ButtonText] forced-colors:aria-pressed:border-[Highlight]" type="button" data-rich-text-editor-target="button" data-action="mousedown->rich-text-editor#keepFocus rich-text-editor#run" data-command="{{ command }}" data-label="{{ label }}"{% if options.sectionLabel ?? false %} data-section-label="{{ options.sectionLabel }}"{% endif %}{% if options.toggle ?? false %} aria-pressed="false"{% endif %}>
{% if options.icon ?? true %}
    {{ _self.icon(command) }}
    <span class="sr-only" data-role="name">{{ label }}</span>
    {{ _self.tooltip(label) }}
{% else %}
    <span class="px-1">{{ label }}</span>
{% endif %}
</button>
{% endmacro %}
{#
    Opens the menu of block kinds, the same one "/" opens. Its name says the
    current kind, which the controller keeps up to date.
#}
{% macro blockTypeButton(id) %}
<button class="relative inline-flex min-h-11 cursor-pointer items-center justify-center gap-1 rounded-control border-2 border-border bg-surface px-2 text-[1rem] font-bold text-text hover:border-accent aria-disabled:cursor-not-allowed aria-disabled:text-muted aria-disabled:opacity-60 forced-colors:border-[ButtonText]" type="button" aria-haspopup="listbox" aria-expanded="false" aria-controls="{{ id }}-menu" data-rich-text-editor-target="blockType" data-action="mousedown->rich-text-editor#keepFocus rich-text-editor#openBlockMenu">
    <span class="sr-only">{{ 'ui.editor.block_type'|trans }}:</span>
    <span class="w-32 truncate text-left" data-role="name"></span>
    <svg class="h-4 w-4 flex-none" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 6l4 4 4-4" /></svg>
</button>
{% endmacro %}
{% macro separator() %}
<span class="mx-0.5 h-7 w-0.5 flex-none bg-divider" aria-hidden="true"></span>
{% endmacro %}
<div class="grid gap-3" data-controller="rich-text-editor" data-rich-text-editor-id-value="{{ id }}" data-rich-text-editor-placeholder-value="{{ placeholder }}" data-rich-text-editor-slash-hint-value="{{ 'ui.editor.slash_hint'|trans }}" data-rich-text-editor-quote-source-hint-value="{{ 'ui.editor.quote_source_hint'|trans }}" data-rich-text-editor-block-type-label-value="{{ 'ui.editor.block_type'|trans }}" data-rich-text-editor-block-options-value="{{ this.blockOptions|map(option => {value: option.value, label: option.label|trans(option.labelParameters)})|json_encode }}" data-rich-text-editor-moved-up-value="{{ 'ui.editor.moved_up'|trans }}" data-rich-text-editor-moved-down-value="{{ 'ui.editor.moved_down'|trans }}" data-rich-text-editor-section-moved-up-value="{{ 'ui.editor.section_moved_up'|trans }}" data-rich-text-editor-section-moved-down-value="{{ 'ui.editor.section_moved_down'|trans }}" data-rich-text-editor-features-value="{{ features|json_encode }}" data-rich-text-editor-callout-labels-value="{{ this.calloutLabels|map(key => key|trans)|json_encode }}"{% if singleParagraph %} data-rich-text-editor-single-paragraph-value="true"{% endif %}{% if this.allowsImages %} data-rich-text-editor-image-search-url-value="{{ imageSearchUrl }}" data-rich-text-editor-image-lookup-url-value="{{ imageLookupUrl }}" data-rich-text-editor-image-labels-value="{{ {loading: 'ui.editor.image.loading'|trans, missing: 'ui.editor.image.missing'|trans, unknown: 'ui.editor.image.unknown'|trans, error: 'ui.editor.image.error'|trans, offSite: 'ui.editor.image.off_site'|trans, result: 'ui.editor.image.result'|trans, results: 'ui.editor.image.results'|trans, none: 'ui.editor.image.none'|trans, embedded: 'ui.editor.image.embedded'|trans}|json_encode }}"{% endif %}{% if this.picksPages %} data-rich-text-editor-link-targets-value="{{ linkTargets|json_encode }}" data-rich-text-editor-page-labels-value="{{ {title: 'ui.editor.link.title'|trans, loading: 'ui.editor.link.loading'|trans, missing: 'ui.editor.link.missing'|trans, unknown: 'ui.editor.link.unknown'|trans, target: 'ui.editor.link.target'|trans, offSite: 'ui.editor.link.off_site'|trans, result: 'ui.editor.link.result'|trans, results: 'ui.editor.link.results'|trans, none: 'ui.editor.link.none'|trans, error: 'ui.editor.link.error'|trans, removed: 'ui.editor.link.removed'|trans}|json_encode }}"{% endif %}{% if this.allowsWidgets %} data-rich-text-editor-widget-labels-value="{{ {title: 'ui.editor.widget.title'|trans, label: 'ui.editor.widget.label'|trans, loading: 'ui.editor.widget.loading'|trans, missing: 'ui.editor.widget.missing'|trans, unknown: 'ui.editor.widget.unknown'|trans, offSite: 'ui.editor.widget.off_site'|trans, result: 'ui.editor.widget.result'|trans, results: 'ui.editor.widget.results'|trans}|json_encode }}"{% endif %}{% if maxLength %} data-rich-text-editor-max-length-value="{{ maxLength }}" data-rich-text-editor-count-value="{{ 'ui.editor.count'|trans }}" data-rich-text-editor-count-over-value="{{ 'ui.editor.count_over'|trans }}"{% endif %}>
    <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
        <span class="{{ hideLabel ? 'sr-only' : 'text-[1rem] font-bold' }}" id="{{ id }}-label">{{ label }}</span>
        <p class="m-0 text-[1rem] text-muted" id="{{ id }}-hint" data-rich-text-editor-target="hint" hidden>{{ hint ?? 'ui.editor.hint'|trans }}</p>
    </div>
    <noscript>
        <p class="m-0 rounded-control border-2 border-border bg-surface p-4 text-[1rem] text-muted">{{ 'ui.editor.noscript'|trans }}</p>
    </noscript>
    <div class="grid gap-3" data-rich-text-editor-target="frame" hidden>
        <div class="relative min-w-0 rounded-card border-2 border-border bg-surface has-[.ProseMirror-focused]:border-accent has-[.ProseMirror-focused]:outline-3 has-[.ProseMirror-focused]:outline-offset-3 has-[.ProseMirror-focused]:outline-focus forced-colors:border-[ButtonText]" data-rich-text-editor-target="canvas" data-action="focusout->rich-text-editor#leave keydown->rich-text-editor#controlsKey">
            <div data-rich-text-editor-target="editor"></div>

            {# Pinned at the bottom, right above the form actions, where the thumb reaches it. #}
            <div class="sticky bottom-[5.25rem] z-20 flex flex-col gap-1 rounded-b-card border-t border-divider bg-surface p-2" role="toolbar" aria-label="{{ 'ui.editor.toolbar'|trans }}" aria-controls="{{ id }}" data-rich-text-editor-target="dock" hidden>
                <div class="flex flex-wrap items-center gap-1">
{% if not singleParagraph %}
                    {{ _self.blockTypeButton(id) }}
                    {{ _self.button('moveUp', 'ui.editor.move_up'|trans, {sectionLabel: 'ui.editor.move_section_up'|trans}) }}
                    {{ _self.button('moveDown', 'ui.editor.move_down'|trans, {sectionLabel: 'ui.editor.move_section_down'|trans}) }}
                    {{ _self.separator() }}
{% endif %}
{% if this.allowsBold %}
                    {{ _self.button('bold', 'ui.editor.bold'|trans, {toggle: true}) }}
{% endif %}
{% if this.allowsLinks %}
                    {{ _self.button('insertLink', 'ui.editor.link.insert'|trans) }}
{% endif %}
{% if this.allowsTables %}
                    {{ _self.button('insertTable', 'ui.editor.table.insert'|trans) }}
{% endif %}
{% if this.allowsImages %}
                    {{ _self.button('insertImage', 'ui.editor.image.insert'|trans) }}
{% endif %}
{% if this.allowsWidgets %}
                    {{ _self.button('insertWidget', 'ui.editor.widget.insert'|trans) }}
{% endif %}
{% if this.allowsBold or this.allowsLinks or this.allowsTables or this.allowsImages or this.allowsWidgets %}
                    {{ _self.separator() }}
{% endif %}
                    {{ _self.button('undo', 'ui.editor.undo'|trans) }}
                    {{ _self.button('redo', 'ui.editor.redo'|trans) }}
{% if not singleParagraph %}
                    <button class="group/button relative ml-auto inline-flex min-h-11 cursor-pointer items-center gap-2 rounded-control border-2 border-border bg-surface px-3 text-[1rem] font-bold text-text hover:border-accent forced-colors:border-[ButtonText]" type="button" commandfor="{{ id }}-outline-dialog" command="show-modal" aria-haspopup="dialog" data-action="mousedown->rich-text-editor#keepFocus" data-rich-text-editor-target="outlineButton" hidden>
                        {{ _self.icon('outline') }}
                        <span>{{ 'ui.editor.outline'|trans }}</span>
                    </button>
{% endif %}
                </div>
{% if this.allowsTables %}
                {# Only while the cursor is in a table: elsewhere these do nothing. #}
                <div class="flex flex-wrap items-center gap-1 border-t border-divider pt-1" role="group" aria-label="{{ 'ui.editor.groups.table'|trans }}" data-rich-text-editor-target="tableTools" hidden>
                    {{ _self.button('addRowAfter', 'ui.editor.table.add_row'|trans) }}
                    {{ _self.button('addColumnAfter', 'ui.editor.table.add_column'|trans) }}
                    {{ _self.button('deleteRow', 'ui.editor.table.delete_row'|trans) }}
                    {{ _self.button('deleteColumn', 'ui.editor.table.delete_column'|trans) }}
                    {{ _self.button('deleteTable', 'ui.editor.table.delete'|trans) }}
                </div>
{% endif %}
{% if this.allowsQuotes %}
                {# Only while the cursor is in a quote. #}
                <div class="flex flex-wrap items-center gap-1 border-t border-divider pt-1" role="group" aria-label="{{ 'ui.editor.groups.quote'|trans }}" data-rich-text-editor-target="quoteTools" hidden>
                    {{ _self.button('quoteSource', 'ui.editor.quote_source'|trans, {icon: false}) }}
                </div>
{% endif %}
{% if this.allowsLinks %}
                {# Only while the cursor is in a link: where it goes, in words, and what to do with it. #}
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-divider pt-1" role="group" aria-label="{{ 'ui.editor.groups.link'|trans }}" data-rich-text-editor-target="linkTools" hidden>
                    <p class="m-0 min-w-0 basis-full px-1 text-[1rem] sm:flex-1 sm:basis-auto" data-rich-text-editor-target="linkTarget"></p>
                    <div class="flex flex-wrap items-center gap-1">
                        {{ _self.button('changeLink', 'ui.editor.link.change'|trans, {icon: false}) }}
                        {{ _self.button('unlink', 'ui.editor.link.remove'|trans, {icon: false}) }}
                    </div>
                </div>
{% endif %}
            </div>

            {# Menu of block kinds, opened by "/" or by the block kind button. #}
            <ul class="fixed z-40 m-0 max-h-72 w-64 list-none overflow-y-auto rounded-control border-2 border-border bg-surface p-1 shadow-card" id="{{ id }}-menu" role="listbox" tabindex="-1" aria-label="{{ 'ui.editor.slash_menu'|trans }}" data-rich-text-editor-target="menu" data-action="keydown->rich-text-editor#menuButtonKey focusout->rich-text-editor#menuFocusOut" hidden></ul>
        </div>
{% if maxLength %}
        <p class="m-0 text-[1rem] text-muted" id="{{ id }}-count" data-rich-text-editor-target="count"></p>
{% endif %}
{% if not singleParagraph %}
        <details class="group rounded-control border border-divider bg-surface">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-3 rounded-control px-4 py-2 text-[1rem] font-bold hover:text-accent [&::-webkit-details-marker]:hidden">
                <span>{{ 'ui.editor.help_summary'|trans }}</span>
                <svg class="h-5 w-5 flex-none transition-transform group-open:rotate-180 motion-reduce:transition-none" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 7.5l5 5 5-5" />
                </svg>
            </summary>
            <div class="grid gap-2 border-t border-divider px-4 py-3 text-[1rem] text-muted">
                <p class="m-0">{{ 'ui.editor.help_controls'|trans }}</p>
                <p class="m-0">{{ 'ui.editor.help_keyboard'|trans }}</p>
            </div>
        </details>
{% endif %}
    </div>

{% if not singleParagraph %}
    {# The outline of the headings, in a dialog opened from the dock: every section one step away. #}
    <dialog class="m-auto max-h-[calc(100dvh_-_2rem)] w-[calc(100%_-_2rem)] max-w-[28rem] overflow-y-auto rounded-card border-2 border-border bg-surface p-0 text-text shadow-card backdrop:bg-black/60" id="{{ id }}-outline-dialog" aria-labelledby="{{ id }}-outline-title" closedby="any" data-rich-text-editor-target="outlineDialog">
        <div class="flex flex-col gap-4 p-[clamp(1.25rem,4vw,2rem)]">
            <div class="flex items-center justify-between gap-4">
                <h2 class="m-0 text-xl font-bold" id="{{ id }}-outline-title">{{ 'ui.editor.outline'|trans }}</h2>
                <button class="flex h-11 w-11 flex-none cursor-pointer items-center justify-center rounded-control border-2 border-border bg-surface text-text hover:border-accent hover:text-accent forced-colors:border-[ButtonText]" type="button" commandfor="{{ id }}-outline-dialog" command="close">
                    <span class="sr-only">{{ 'ui.close'|trans }}</span>
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </div>
            <ol class="m-0 flex list-none flex-col gap-0.5 p-0" data-rich-text-editor-target="outlineDialogList"></ol>
        </div>
    </dialog>
{% endif %}
{% if this.allowsImages %}
    {# The images of the library to embed one, searched by their alternative text. #}
    <dialog class="m-auto max-h-[calc(100dvh_-_2rem)] w-[calc(100%_-_2rem)] max-w-[40rem] overflow-y-auto rounded-card border-2 border-border bg-surface p-0 text-text shadow-card backdrop:bg-black/60" id="{{ id }}-image-dialog" aria-labelledby="{{ id }}-image-title" closedby="any" data-rich-text-editor-target="imageDialog">
        <div class="flex flex-col gap-4 p-[clamp(1.25rem,4vw,2rem)]">
            <div class="flex items-center justify-between gap-4">
                <h2 class="m-0 text-xl font-bold" id="{{ id }}-image-title">{{ 'ui.editor.image.title'|trans }}</h2>
                <button class="flex h-11 w-11 flex-none cursor-pointer items-center justify-center rounded-control border-2 border-border bg-surface text-text hover:border-accent hover:text-accent forced-colors:border-[ButtonText]" type="button" commandfor="{{ id }}-image-dialog" command="close">
                    <span class="sr-only">{{ 'ui.close'|trans }}</span>
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </div>
            {#
                Not a form: the editor sits in the form of what it edits, and
                a form can't hold another. Enter and the button search.
            #}
            <div class="flex flex-col gap-2" role="search">
                <label class="text-[1rem] font-bold" for="{{ id }}-image-search">{{ 'ui.editor.image.search'|trans }}</label>
                <div class="flex gap-2">
                    <input class="min-h-12 min-w-0 flex-1 rounded-control border-2 border-border bg-surface px-[0.9rem] py-3 text-text focus-visible:border-accent" type="search" id="{{ id }}-image-search" data-rich-text-editor-target="imageSearch" data-action="keydown.enter->rich-text-editor#searchImages">
                    <button class="min-h-12 cursor-pointer rounded-control border-2 border-accent bg-surface px-4 text-[1rem] font-bold text-accent hover:bg-accent hover:text-on-accent forced-colors:border-[ButtonText]" type="button" data-action="rich-text-editor#searchImages">{{ 'ui.editor.image.search_submit'|trans }}</button>
                </div>
            </div>
            <p class="m-0 text-[1rem] text-muted" role="status" data-rich-text-editor-target="imageStatus"></p>
            <ul class="m-0 grid list-none gap-2 p-0" aria-label="{{ 'ui.editor.image.list'|trans }}" data-rich-text-editor-target="imageResults"></ul>
        </div>
    </dialog>
{% endif %}
{% if this.picksPages %}
    {#
        What to link the selected text to, or to show in a widget: a kind
        of content first, then one of it searched by its name. Its title
        says which.
    #}
    <dialog class="m-auto max-h-[calc(100dvh_-_2rem)] w-[calc(100%_-_2rem)] max-w-[40rem] overflow-y-auto rounded-card border-2 border-border bg-surface p-0 text-text shadow-card backdrop:bg-black/60" id="{{ id }}-page-dialog" aria-labelledby="{{ id }}-page-title" closedby="any" data-rich-text-editor-target="pageDialog">
        <div class="flex flex-col gap-4 p-[clamp(1.25rem,4vw,2rem)]">
            <div class="flex items-center justify-between gap-4">
                <h2 class="m-0 text-xl font-bold" id="{{ id }}-page-title" data-rich-text-editor-target="pageDialogTitle">{{ (this.allowsLinks ? 'ui.editor.link.title' : 'ui.editor.widget.title')|trans }}</h2>
                <button class="flex h-11 w-11 flex-none cursor-pointer items-center justify-center rounded-control border-2 border-border bg-surface text-text hover:border-accent hover:text-accent forced-colors:border-[ButtonText]" type="button" commandfor="{{ id }}-page-dialog" command="close">
                    <span class="sr-only">{{ 'ui.close'|trans }}</span>
                    <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" /></svg>
                </button>
            </div>
            {# Not a form: the editor already sits in the form of its page. #}
            <fieldset class="m-0 flex min-w-0 flex-wrap gap-x-4 gap-y-2 border-0 p-0">
                <legend class="mb-2 p-0 text-[1rem] font-bold">{{ 'ui.editor.link.kind'|trans }}</legend>
{% for target in linkTargets %}
                <label class="flex min-h-11 cursor-pointer items-center gap-2 text-[1rem]">
                    <input class="h-5 w-5 flex-none accent-[var(--color-accent)]" type="radio" name="{{ id }}-page-kind" value="{{ target.kind }}"{% if loop.first %} checked{% endif %} data-action="change->rich-text-editor#chooseKind">
                    {{ ('ui.editor.link.kinds.' ~ target.kind)|trans }}
                </label>
{% endfor %}
            </fieldset>
            <div class="flex flex-col gap-2" role="search">
                <label class="text-[1rem] font-bold" for="{{ id }}-page-search">{{ 'ui.editor.link.search'|trans }}</label>
                <div class="flex gap-2">
                    <input class="min-h-12 min-w-0 flex-1 rounded-control border-2 border-border bg-surface px-[0.9rem] py-3 text-text focus-visible:border-accent" type="search" id="{{ id }}-page-search" data-rich-text-editor-target="pageSearch" data-action="keydown.enter->rich-text-editor#searchPages">
                    <button class="min-h-12 cursor-pointer rounded-control border-2 border-accent bg-surface px-4 text-[1rem] font-bold text-accent hover:bg-accent hover:text-on-accent forced-colors:border-[ButtonText]" type="button" data-action="rich-text-editor#searchPages">{{ 'ui.editor.link.search_submit'|trans }}</button>
                </div>
            </div>
            <p class="m-0 text-[1rem] text-muted" role="status" data-rich-text-editor-target="pageStatus"></p>
            <ul class="m-0 grid list-none gap-2 p-0" aria-label="{{ 'ui.editor.link.list'|trans }}" data-rich-text-editor-target="pageResults"></ul>
            <button class="min-h-12 cursor-pointer self-start rounded-control border-2 border-accent bg-surface px-4 text-[1rem] font-bold text-accent hover:bg-accent hover:text-on-accent forced-colors:border-[ButtonText]" type="button" data-rich-text-editor-target="pageMore" data-action="rich-text-editor#morePages" hidden>{{ 'ui.editor.link.more'|trans }}</button>
        </div>
    </dialog>
{% endif %}
    <p class="sr-only" aria-live="polite" data-rich-text-editor-target="status"></p>
    <input type="hidden" name="{{ name }}" value="{{ value }}" data-rich-text-editor-target="input">
</div>
