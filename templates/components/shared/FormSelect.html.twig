<select{{ attributes.defaults({class: 'w-full min-h-12 cursor-pointer rounded-control border border-border bg-bg px-[0.9rem] py-3 text-text focus-visible:border-accent forced-colors:border-[ButtonText]'}) }} id="{{ id }}" name="{{ name }}">
{% if this.none is not null %}
    <option value=""{% if value == '' %} selected{% endif %}>{{ this.none }}</option>
{% endif %}
{% for option in options %}
    <option value="{{ option.value }}"{% if option.value == value %} selected{% endif %}>{{ option.label }}</option>
{% endfor %}
</select>
