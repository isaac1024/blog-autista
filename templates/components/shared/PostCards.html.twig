{#
    Each card is one link, a single stop for the keyboard, named by all it
    says. Its title is a heading, so the cards can be skimmed by headings
    too. The image says nothing the title doesn't, so it has no alternative
    text. The first picture of a list that opens its page comes first, as
    it may be the largest thing on the screen; the others wait until they
    are near it.
#}
<ul class="m-0 grid list-none gap-x-10 gap-y-12 p-0 sm:grid-cols-2">
{% for card in cards %}
    <li class="m-0 p-0">
        <article class="h-full">
            <a class="group grid content-start gap-3 text-text no-underline forced-colors:text-[LinkText]" href="{{ card.url }}">
{% if card.image %}
                <img class="block aspect-video h-auto w-full bg-surface object-cover" src="{{ card.image.src }}" srcset="{{ card.image.srcset }}" sizes="(min-width: 40rem) 21rem, 100vw" width="{{ card.image.width }}" height="{{ card.image.height }}" alt=""{% if lead and loop.first %} fetchpriority="high"{% else %} loading="lazy" decoding="async"{% endif %}>
{% endif %}
                <div class="grid gap-1.5">
                    <span class="text-base text-accent">{{ card.section }}</span>
                    <h{{ headingLevel }} class="m-0 text-[1.375rem] leading-snug font-semibold text-balance decoration-[0.06em] underline-offset-[0.2em] group-hover:underline">{{ card.title }}</h{{ headingLevel }}>
{% if card.excerpt %}
                    <span class="leading-normal">{{ card.excerpt }}</span>
{% endif %}
                    <time class="text-base text-muted" datetime="{{ card.datetime }}">{{ card.date }}</time>
                </div>
            </a>
        </article>
    </li>
{% endfor %}
</ul>
