{#
    Each card is one link, a single stop for the keyboard, named by all it
    says. Its title is a heading, so the cards can be skimmed by headings
    too. The image says nothing the title doesn't, so it has no alternative
    text.
#}
<ul class="m-0 grid list-none gap-6 p-0 sm:grid-cols-2{{ wide ? ' lg:grid-cols-3' : '' }}">
{% for card in cards %}
    <li class="m-0 p-0">
        <article class="h-full">
            <a class="group flex h-full flex-col overflow-hidden rounded-card border-2 border-border bg-surface text-text no-underline transition-colors duration-150 hover:border-accent motion-reduce:transition-none forced-colors:border-[LinkText]" href="{{ card.url }}">
{% if card.image %}
                <img class="block aspect-video h-auto w-full bg-bg object-cover" src="{{ card.image.src }}" srcset="{{ card.image.srcset }}" sizes="{{ wide ? '(min-width: 64rem) 22rem, (min-width: 40rem) 45vw, 100vw' : '(min-width: 40rem) 21rem, 100vw' }}" width="{{ card.image.width }}" height="{{ card.image.height }}" alt="" loading="lazy" decoding="async">
{% endif %}
                <span class="flex flex-1 flex-col gap-2 p-5">
                    <span class="text-[1rem] font-bold text-muted">{{ card.section }}</span>
                    <h{{ headingLevel }} class="m-0 text-xl font-bold leading-tight text-balance text-accent underline decoration-[0.1em] underline-offset-[0.15em] group-hover:text-accent-strong">{{ card.title }}</h{{ headingLevel }}>
{% if card.excerpt %}
                    <span class="text-[1rem]">{{ card.excerpt }}</span>
{% endif %}
                    <time class="mt-auto text-[1rem] text-muted" datetime="{{ card.datetime }}">{{ card.date }}</time>
                </span>
            </a>
        </article>
    </li>
{% endfor %}
</ul>
