{% import 'shared/render_component.html.twig' as renderer %}
<header class="m-0 flex flex-wrap items-start justify-between gap-x-6 gap-y-4">
    <div class="flex min-w-0 flex-col gap-2">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <h1 class="m-0 font-bold text-balance break-words {{ variant == 'login' ? 'text-[clamp(1.75rem,5vw,2.25rem)] leading-[1.2]' : 'text-[clamp(1.875rem,4vw,2.5rem)] leading-tight' }}">{{ title }}</h1>
{% if badge %}
            <twig:Shared:Badge :label="badge" variant="accent" />
{% endif %}
        </div>
{% if subtitle %}
        <p class="m-0 max-w-[60ch] {{ variant == 'login' ? 'text-[1rem]' : 'text-lg' }} text-muted">{{ subtitle }}</p>
{% endif %}
    </div>
{% if children is not empty %}
    <div class="flex flex-none flex-wrap items-center gap-3">
{% for child in children %}
        {{ renderer.render(child) }}
{% endfor %}
    </div>
{% endif %}
</header>
