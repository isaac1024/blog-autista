<header class="m-0">
    <h1 class="m-0 font-bold text-balance {{ variant == 'login' ? 'text-[clamp(1.75rem,5vw,2.25rem)] leading-[1.2]' : 'text-[clamp(2rem,5vw,3rem)] leading-tight' }}">{{ title }}</h1>
{% if variant == 'login' %}
    <span class="mt-3 block h-[0.3rem] w-14 bg-linear-to-r from-spectrum-1 to-spectrum-2" aria-hidden="true"></span>
{% endif %}
{% if subtitle %}
    <p class="mt-3 {{ variant == 'login' ? 'text-[1rem]' : 'text-lg' }} text-muted">{{ subtitle }}</p>
{% endif %}
</header>
