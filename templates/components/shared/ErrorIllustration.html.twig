{#
    Drawn in the colours of the theme, so it follows the one the reader has.
    Hidden from assistive technology: the title says what it shows.
#}
<div class="-mx-[clamp(1rem,4vw,2rem)] sm:mx-0">
<svg class="block h-auto w-full sm:max-w-[32rem]" viewBox="0 0 320 200" aria-hidden="true" focusable="false">
{% if error == 'gone' %}
    <rect class="fill-surface" width="320" height="172"/>
    <rect class="fill-accent-soft" x="104" y="46" width="104" height="84"/>
    <path class="stroke-accent" d="M156 28 112 50M156 28l44 22" fill="none" stroke-width="1.5" stroke-dasharray="4 5" stroke-linecap="round"/>
    <circle class="fill-accent" cx="156" cy="28" r="3.5"/>
    <path class="stroke-divider" d="M0 172h320" stroke-width="2"/>
    <path class="fill-bg stroke-accent" d="M238 172l4-24h24l4 24z" stroke-width="2" stroke-linejoin="round"/>
    <path class="stroke-accent" d="M254 148c-4-16-14-22-24-24M254 148c4-20 14-26 24-28M254 148v-26" fill="none" stroke-width="2" stroke-linecap="round"/>
{% elseif error == 'server_error' %}
    <path class="stroke-accent" d="M136 86c-10-16 10-24 0-42M160 86c-10-18 10-26 0-48M184 86c-10-16 10-24 0-40" fill="none" stroke-width="2" stroke-linecap="round" opacity="0.6"/>
    <ellipse class="fill-accent-soft" cx="160" cy="170" rx="74" ry="9"/>
    <path class="fill-surface stroke-accent" d="M108 98h104v20c0 30-20 46-52 46s-52-16-52-46z" stroke-width="2" stroke-linejoin="round"/>
    <path class="stroke-accent" d="M212 108c26 0 26 32-3 32" fill="none" stroke-width="2" stroke-linecap="round"/>
{% else %}
    <circle class="stroke-accent" cx="252" cy="52" r="15" fill="none" stroke-width="2"/>
    <path class="fill-accent-soft" d="M0 118q80-46 160-10t160-12v104H0z"/>
    <path class="fill-surface" d="M0 142q100-30 200-6t120-8v72H0z"/>
    <path class="stroke-accent" d="M150 200c0-24 42-32 26-48s-28-18-10-28" fill="none" stroke-width="3" stroke-linecap="round" stroke-dasharray="0.1 9"/>
    <path class="stroke-accent" d="M207 152v-46" stroke-width="2" stroke-linecap="round"/>
    <path class="fill-bg stroke-accent" d="M194 98h30l7 7-7 7h-30z" stroke-width="2" stroke-linejoin="round"/>
{% endif %}
</svg>
</div>
