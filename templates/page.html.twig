{% extends 'base.html.twig' %}

{% import 'shared/render_component.html.twig' as renderer %}

{% block title %}{{ page.title }}{% endblock %}

{% block meta %}
{% if page.description %}
        <meta name="description" content="{{ page.description }}">
{% endif %}
{% if page.robots %}
        <meta name="robots" content="{{ page.robots }}">
{% endif %}
{% if page.canonical %}
        <link rel="canonical" href="{{ page.canonical }}">
{% endif %}
{#
    What the page is, for search engines, as one JSON-LD graph. A block of
    data, never run, so the content security policy has nothing to allow;
    "<" is escaped, so no text in it can close the element.
#}
{% if page.structuredData is not empty %}
        <script type="application/ld+json">{{ {'@context': 'https://schema.org', '@graph': page.structuredData}|json_encode(constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG'))|raw }}</script>
{% endif %}
{% endblock %}

{% block body %}
{% block regions %}
{% block header %}
{% for component in page.header %}
        {{ renderer.render(component) }}
{% endfor %}
{% endblock %}
{% block main %}
    <main id="main" class="{{ page.mainClass }} grow">
{% block notices %}{% endblock %}
{% for component in page.main %}
        {{ renderer.render(component) }}
{% endfor %}
    </main>
{% endblock %}
{% block footer %}
{% for component in page.footer %}
        {{ renderer.render(component) }}
{% endfor %}
{% endblock %}
{% endblock %}
{% endblock %}
