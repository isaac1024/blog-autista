{% extends 'page.html.twig' %}

{#
    The header and the footer are components of the page, which WebLayout adds
    from what the site tells it, so this layout paints the regions as they come.
#}

{#
    How the page shows when it is shared, as Open Graph tells it to social
    networks and messaging apps: a post as an article, every other page as
    part of the website. Its address is its canonical one, so a page without
    one, such as an error, tells none. Open Graph names a language with the
    country it is written for, Spain for this site. X reads the rest from Open
    Graph, and only needs to know to show the image large.
#}
{% block meta %}
{{ parent() }}
        <meta property="og:type" content="{{ page.article ? 'article' : 'website' }}">
        <meta property="og:title" content="{{ page.title }}">
{% if page.description %}
        <meta property="og:description" content="{{ page.description }}">
{% endif %}
{% if page.canonical %}
        <meta property="og:url" content="{{ page.canonical }}">
{% endif %}
{% if page.siteName %}
        <meta property="og:site_name" content="{{ page.siteName }}">
{% endif %}
        <meta property="og:locale" content="{{ constant('Shared\\Infrastructure\\Ui\\WebLayout::LOCALE') }}_ES">
{% if page.image %}
        <meta property="og:image" content="{{ absolute_url(page.image.src) }}">
        <meta property="og:image:width" content="{{ page.image.width }}">
        <meta property="og:image:height" content="{{ page.image.height }}">
        <meta property="og:image:alt" content="{{ page.image.alt }}">
{% endif %}
{% if page.article %}
        <meta property="article:published_time" content="{{ page.article.publishedTime }}">
        <meta property="article:modified_time" content="{{ page.article.modifiedTime }}">
{% if page.article.section %}
        <meta property="article:section" content="{{ page.article.section }}">
{% endif %}
{% for tag in page.article.tags %}
        <meta property="article:tag" content="{{ tag }}">
{% endfor %}
{% endif %}
        <meta name="twitter:card" content="{{ page.image ? 'summary_large_image' : 'summary' }}">
{% endblock %}

{#
    The scripts of the public site, loaded as plain modules, with no import
    map. A page whose visits are counted tells the site once its reader sees
    it, with no cookie and nothing kept in the browser. A page that embeds
    resources of other sites loads them behind their facades once the reader
    agrees, which their browser keeps.
#}
{% block javascripts %}
{% if page.countedContent %}
        <script type="module" src="{{ asset('web.js') }}" data-type="{{ page.countedContent.type }}" data-content="{{ page.countedContent.id }}" data-visit="{{ path('web_visit') }}"></script>
{% endif %}
{% if page.frames is not empty %}
        <script type="module" src="{{ asset('external.js') }}"></script>
{% endif %}
{% endblock %}
