{% extends 'page.html.twig' %}

{#
    The header and the footer are components of the page, which WebLayout adds
    from what the site tells it, so this layout paints the regions as they come.
#}

{#
    The only script of the public site, for a page whose visits are counted:
    it tells the site once its reader sees the page, with no cookie and
    nothing kept in the browser. Loaded as a plain module, with no import map.
#}
{% block javascripts %}
{% if page.countedPageId %}
        <script type="module" src="{{ asset('web.js') }}" data-page="{{ page.countedPageId }}" data-visit="{{ path('web_visit') }}"></script>
{% endif %}
{% endblock %}
