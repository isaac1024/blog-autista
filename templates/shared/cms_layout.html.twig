{% extends 'page.html.twig' %}

{#
    Icons only accompany the text of each item, which names it: they help
    recognise the item at a glance, never replace its label.
#}
{% macro icon(name) %}
<svg class="h-5 w-5 flex-none" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
{% if name == 'posts' %}
    <path d="M4.5 19.5h4l10-10a2.83 2.83 0 0 0-4-4l-10 10z" /><path d="M13.5 6.5l4 4M12 19.5h7.5" />
{% elseif name == 'pages' %}
    <path d="M14 3.5H7a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8.5z" /><path d="M14 3.5v5h5M9 13h6M9 16.5h4" />
{% elseif name == 'images' %}
    <rect x="3.5" y="4.5" width="17" height="15" rx="2" /><circle cx="9" cy="10" r="1.75" /><path d="M20.5 15.5l-5-5-9 9" />
{% elseif name == 'sections' %}
    <path d="M3.5 7.5a2 2 0 0 1 2-2h4l2 2.5h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-13a2 2 0 0 1-2-2z" />
{% elseif name == 'tags' %}
    <path d="M3.5 12.6V5.5a2 2 0 0 1 2-2h7.1a2 2 0 0 1 1.4.6l6.4 6.4a2 2 0 0 1 0 2.8l-7.1 7.1a2 2 0 0 1-2.8 0L4.1 14a2 2 0 0 1-.6-1.4z" /><circle cx="8.5" cy="8.5" r="1.5" />
{% elseif name == 'authors' %}
    <circle cx="12" cy="8.5" r="4" /><path d="M4.5 20.5a7.5 7.5 0 0 1 15 0" />
{% elseif name == 'externals' %}
    <path d="M13.5 4.5h6v6M19.5 4.5l-8 8M10 6.5H6.5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2V14" />
{% elseif name == 'redirects' %}
    <path d="M4 7.5h11.5M12 3.5l4 4-4 4M20 16.5H8.5M12 12.5l-4 4 4 4" />
{% elseif name == 'settings' %}
    <circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
{% elseif name == 'visits' %}
    <path d="M4 20.5h16M7 16.5v-5M12 16.5v-9M17 16.5v-12" />
{% elseif name == 'logout' %}
    <path d="M10 20.5H6a2 2 0 0 1-2-2v-13a2 2 0 0 1 2-2h4M16 16.5l4.5-4.5L16 7.5M20.5 12H9.5" />
{% endif %}
</svg>
{% endmacro %}

{% macro item(label, url, icon, current) %}
<a class="flex min-h-11 items-center gap-3 rounded-control border-l-4 px-3 py-2 no-underline transition-colors duration-150 motion-reduce:transition-none {{ current ? 'border-accent bg-accent-soft font-bold text-text' : 'border-transparent text-text hover:bg-bg' }} forced-colors:border-[CanvasText]" href="{{ url }}"{% if current %} aria-current="page"{% endif %}>
    {{ _self.icon(icon) }}
    <span>{{ label }}</span>
</a>
{% endmacro %}

{% macro navigation(currentRoute) %}
<div class="flex flex-col gap-6">
    <div>
        <p class="m-0 mb-2 px-3 text-[0.875rem] font-bold text-muted">{{ 'cms.nav.content'|trans }}</p>
        <ul class="m-0 flex list-none flex-col gap-1 p-0">
            <li>{{ _self.item('cms.nav.posts'|trans, path('cms_posts'), 'posts', currentRoute starts with 'cms_posts') }}</li>
            <li>{{ _self.item('cms.nav.pages'|trans, path('cms_pages'), 'pages', currentRoute starts with 'cms_pages') }}</li>
            <li>{{ _self.item('cms.nav.images'|trans, path('cms_images'), 'images', currentRoute starts with 'cms_images') }}</li>
            <li>{{ _self.item('cms.nav.sections'|trans, path('cms_terms', {taxonomy: 'sections'}), 'sections', currentRoute starts with 'cms_terms' and app.request.attributes.get('taxonomy') == 'sections') }}</li>
            <li>{{ _self.item('cms.nav.tags'|trans, path('cms_terms', {taxonomy: 'tags'}), 'tags', currentRoute starts with 'cms_terms' and app.request.attributes.get('taxonomy') == 'tags') }}</li>
            <li>{{ _self.item('cms.nav.authors'|trans, path('cms_authors'), 'authors', currentRoute starts with 'cms_authors') }}</li>
            <li>{{ _self.item('cms.nav.externals'|trans, path('cms_externals'), 'externals', currentRoute starts with 'cms_externals') }}</li>
            <li>{{ _self.item('cms.nav.redirects'|trans, path('cms_redirects'), 'redirects', currentRoute starts with 'cms_redirects') }}</li>
            <li>{{ _self.item('cms.nav.settings'|trans, path('cms_settings'), 'settings', currentRoute starts with 'cms_settings') }}</li>
        </ul>
    </div>
    <div>
        <p class="m-0 mb-2 px-3 text-[0.875rem] font-bold text-muted">{{ 'cms.nav.audience'|trans }}</p>
        <ul class="m-0 flex list-none flex-col gap-1 p-0">
            <li>{{ _self.item('cms.nav.visits'|trans, path('cms_analytics'), 'visits', currentRoute starts with 'cms_analytics') }}</li>
        </ul>
    </div>
</div>
{% endmacro %}

{% macro account() %}
<nav aria-label="{{ 'cms.nav.account'|trans }}">
    <form method="post" action="{{ path('cms_logout') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
        <button class="flex min-h-11 w-full cursor-pointer items-center gap-3 rounded-control border-l-4 border-transparent px-3 py-2 text-left text-text hover:bg-bg" type="submit">
            {{ _self.icon('logout') }}
            <span>{{ 'cms.nav.logout'|trans }}</span>
        </button>
    </form>
</nav>
{% endmacro %}

{% block regions %}
{% set currentRoute = app.request.attributes.get('_route') %}
    <div class="flex flex-1 flex-col md:flex-row">
        <aside class="relative flex items-center justify-between gap-4 border-b border-divider bg-surface px-[clamp(1rem,4vw,1.5rem)] py-3 md:sticky md:top-0 md:h-dvh md:w-72 md:flex-none md:flex-col md:items-stretch md:justify-start md:gap-8 md:border-b-0 md:border-r md:px-4 md:py-6">
            <twig:Shared:Brand brand="CMS" :homeUrl="path('cms_pages')" class="px-1 text-lg md:px-3" />

            <div class="flex items-center gap-2 md:px-1">
            <twig:Shared:ReadingSettings align="start" />

            <details class="group md:hidden">
                <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-control border border-border bg-surface text-text hover:border-accent hover:text-accent group-open:border-accent group-open:text-accent [&::-webkit-details-marker]:hidden">
                    <span class="sr-only">{{ 'cms.nav.menu'|trans }}</span>
                    <svg class="h-6 w-6 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                    <svg class="hidden h-6 w-6 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                </summary>

                <div class="absolute inset-x-0 top-full z-50 flex flex-col gap-4 border-b border-divider bg-surface px-[clamp(1rem,4vw,1.5rem)] py-4 shadow-card">
                    <nav aria-label="{{ 'cms.nav.administration'|trans }}">
                        {{ _self.navigation(currentRoute) }}
                    </nav>
                    <div class="border-t border-divider pt-4">
                        {{ _self.account() }}
                    </div>
                </div>
            </details>
            </div>

            <nav class="hidden md:block" aria-label="{{ 'cms.nav.administration'|trans }}">
                {{ _self.navigation(currentRoute) }}
            </nav>

            <div class="hidden border-t border-divider pt-4 md:mt-auto md:block">
                {{ _self.account() }}
            </div>
        </aside>

        <div class="flex min-w-0 flex-1 flex-col">
{{ parent() }}
        </div>
    </div>
{% endblock %}

{#
    What the last action did, or what went wrong with it, such as a rule the
    server refused, told at the top of the page it came back to.
#}
{% block notices %}
{% for notice in app.flashes('success') %}
        <twig:Shared:Notice :message="notice.key|trans(notice.parameters)" />
{% endfor %}
{% for error in app.flashes('error') %}
        <twig:Shared:Alert :title="'errors.title'|trans" :message="error.key|trans(error.parameters)" />
{% endfor %}
{% endblock %}

{# The CMS chrome lives in the sidebar: no separate top bar or footer. #}
{% block header %}{% endblock %}
{% block footer %}{% endblock %}

{#
    The base styles of the rich-text editor, linked here rather than imported
    from its controller: AssetMapper turns a CSS import into a data: module,
    which the content security policy refuses.
#}
{% block stylesheets %}
        <link rel="stylesheet" href="{{ asset('vendor/prosemirror-view/style/prosemirror.min.css') }}">
        <link rel="stylesheet" href="{{ asset('vendor/prosemirror-tables/style/tables.min.css') }}">
{% endblock %}

{# The Stimulus controllers of the editors of the CMS; the import map carries the nonce of the request. #}
{% block importmap %}{{ importmap('cms', {nonce: csp_nonce('script')}) }}{% endblock %}
