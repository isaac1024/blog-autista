#!/usr/bin/env bash
#
# Runs every gate of the project over the commit checked out (HEAD), and
# keeps a note that it passed, which bin/deploy asks for before deploying.
#
#   bin/verify
#
# 1. The interface first, alone, with the machine quiet, as Lighthouse
#    measures how fast the pages load: Tailwind's build, the CSS syntax
#    gate, then npm run ui:check.
# 2. Then PHP (composer check:full, mutations included) and JavaScript
#    (npm run check:js:full, mutations included) side by side. The first
#    to fail stops the other.
#
# All of it on CPUS alone (8 cores): the tools count the cores they are
# given and size their workers to them. Each part writes its output to
# var/verify/<part>.log; the end of the one that fails is shown.
#
# It needs the app running in Docker (docker compose up -d), as the
# interface is checked on it, and no change left uncommitted, as the note
# is of HEAD.

set -euo pipefail

cd "$(dirname "$0")/.."

CPUS='0-7'
LOGS='var/verify'
NOTES='var/verify/passed'

fail() { echo "bin/verify: $1" >&2; exit 1; }
step() { printf '\n==> %s\n' "$1"; }

dirty() { [ -n "$(git status --porcelain --untracked-files=no)" ]; }

dirty && fail 'commit or stash your changes first; the gates pass for HEAD.'
curl -s -o /dev/null --max-time 10 http://www.blogautista.localhost/ \
    || fail 'the app is not running; start it with docker compose up -d.'

HEAD_SHA=$(git rev-parse HEAD)
mkdir -p "$LOGS" "$NOTES"
started=$SECONDS

in_php() {
    docker compose exec -T -u www-data php "$@"
}

# Shows the end of a part's log and stops.
failed() {
    printf '\n--- end of %s ---\n' "$LOGS/$1.log" >&2
    tail -n 40 "$LOGS/$1.log" >&2
    fail "$1 failed; the whole output is in $LOGS/$1.log."
}

step "Interface: Tailwind's build and ui:check"
{
    in_php taskset -c "$CPUS" php bin/console tailwind:build \
        && taskset -c "$CPUS" npm run ui:check
} > "$LOGS/ui.log" 2>&1 || failed ui

step 'PHP (composer check:full) and JavaScript (npm run check:js:full), side by side'
# Each part leads a process group of its own, PHP's inside the container,
# so stopping one stops every process it started. setsid waits for it: a
# process already leading its group, as one started by docker exec, would
# otherwise be forked away and look finished at once.
in_php setsid --wait sh -c "echo \$\$ > $LOGS/php.pid; exec taskset -c $CPUS composer check:full" > "$LOGS/php.log" 2>&1 &
php_lane=$!
setsid --wait sh -c "echo \$\$ > $LOGS/js.pid; exec taskset -c $CPUS npm run check:js:full" > "$LOGS/js.log" 2>&1 &
js_lane=$!

stop_lanes() {
    if [ -f "$LOGS/php.pid" ]; then
        in_php sh -c "kill -TERM -- -\$(cat $LOGS/php.pid)" 2>/dev/null || true
    fi
    if [ -f "$LOGS/js.pid" ]; then
        kill -TERM -- "-$(cat "$LOGS/js.pid")" 2>/dev/null || true
    fi
    wait 2>/dev/null || true
    rm -f "$LOGS/php.pid" "$LOGS/js.pid"
}
trap 'stop_lanes; exit 130' INT TERM

declare -A parts=(["$php_lane"]=php ["$js_lane"]=js)
while [ "${#parts[@]}" -gt 0 ]; do
    set +e
    wait -n -p lane "${!parts[@]}"
    status=$?
    set -e
    part=${parts[$lane]}
    unset "parts[$lane]"

    if [ "$status" -ne 0 ]; then
        trap - INT TERM
        stop_lanes
        failed "$part"
    fi

    echo "    $part passed"
done
trap - INT TERM
rm -f "$LOGS/php.pid" "$LOGS/js.pid"

# Nothing changed while they ran, or the note would be of something else.
if dirty || [ "$(git rev-parse HEAD)" != "$HEAD_SHA" ]; then
    fail 'the code changed while the gates ran; run bin/verify again.'
fi

touch "$NOTES/$HEAD_SHA"
step "All gates passed for $(git rev-parse --short HEAD) in $(((SECONDS - started) / 60))m$(((SECONDS - started) % 60))s"
