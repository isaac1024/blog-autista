#!/usr/bin/env bash
#
# Runs every gate of the project over the commit checked out (HEAD), and
# keeps a note that it passed, which bin/deploy asks for before deploying.
#
#   bin/verify
#
# 1. The interface first, alone, with the machine quiet, as Lighthouse
#    measures how fast the pages load: Tailwind's build, the CSS syntax
#    gate, then npm run ui:check.
# 2. Then the gates of composer check:full and npm run check:js:full, in
#    four lanes side by side, each running its steps one after another:
#      php-static  composer audit:all, cs:check, twig:cs:check, complexity, stan, schema
#      php-tests   composer test, then infection
#      js-static   npm run audit:js, lint:js, typecheck:js
#      js-tests    npm run test:js, then mutation:js
#    The mutations wait for the tests they mutate, and the static gates
#    run beside them. The first lane to fail stops the others.
#
# All of it on CPUS alone (8 cores): the tools count the cores they are
# given and size their workers to them. Each lane writes its output to
# var/verify/<lane>.log; the end of the one that fails is shown.
#
# A step added to check:full or check:js:full is added here too.
#
# It needs the app running in Docker (docker compose up -d), as the
# interface is checked on it, and no change left uncommitted, as the note
# is of HEAD.

set -euo pipefail

cd "$(dirname "$0")/.."

CPUS='0-7'
LOGS='var/verify'
NOTES='var/verify/passed'

fail() { echo "bin/verify: $1" >&2; exit 1; }
step() { printf '\n==> %s\n' "$1"; }

dirty() { [ -n "$(git status --porcelain --untracked-files=no)" ]; }

dirty && fail 'commit or stash your changes first; the gates pass for HEAD.'
curl -s -o /dev/null --max-time 10 http://www.blogautista.localhost/ \
    || fail 'the app is not running; start it with docker compose up -d.'

HEAD_SHA=$(git rev-parse HEAD)
mkdir -p "$LOGS" "$NOTES"
rm -f "$LOGS"/*.pid
started=$SECONDS

in_php() {
    docker compose exec -T -u www-data php "$@"
}

elapsed() { echo "$(((SECONDS - started) / 60))m$(((SECONDS - started) % 60))s"; }

# Shows the end of a lane's log and stops.
failed() {
    printf '\n--- end of %s ---\n' "$LOGS/$1.log" >&2
    tail -n 40 "$LOGS/$1.log" >&2
    fail "$1 failed after $(elapsed); the whole output is in $LOGS/$1.log."
}

step "Interface: Tailwind's build and ui:check"
{
    in_php taskset -c "$CPUS" php bin/console tailwind:build \
        && taskset -c "$CPUS" npm run ui:check
} > "$LOGS/ui.log" 2>&1 || failed ui
echo "    ui passed ($(elapsed))"

# Each lane leads a process group of its own, those of PHP inside the
# container, so stopping one stops every process it started. setsid waits
# for it: a process already leading its group, as one started by docker
# exec, would otherwise be forked away and look finished at once.
declare -A lanes=()

php_lane() {
    in_php setsid --wait sh -c "echo \$\$ > $LOGS/$1.pid; exec taskset -c $CPUS sh -c '$2'" > "$LOGS/$1.log" 2>&1 &
    lanes[$!]=$1
}

js_lane() {
    setsid --wait sh -c "echo \$\$ > $LOGS/$1.pid; exec taskset -c $CPUS sh -c '$2'" > "$LOGS/$1.log" 2>&1 &
    lanes[$!]=$1
}

stop_lanes() {
    local pidfile lane
    for pidfile in "$LOGS"/*.pid; do
        [ -f "$pidfile" ] || continue
        lane=$(basename "$pidfile" .pid)
        case $lane in
            php-*) in_php sh -c "kill -TERM -- -\$(cat $pidfile)" 2>/dev/null || true ;;
            *) kill -TERM -- "-$(cat "$pidfile")" 2>/dev/null || true ;;
        esac
    done
    wait 2>/dev/null || true
    rm -f "$LOGS"/*.pid
}

step 'Static gates, tests and mutations, in four lanes side by side'
php_lane php-static 'composer audit:all && composer cs:check && composer twig:cs:check && composer complexity && composer stan && composer schema'
php_lane php-tests 'composer test && composer infection'
js_lane js-static 'npm run audit:js && npm run lint:js && npm run typecheck:js'
js_lane js-tests 'npm run test:js && npm run mutation:js'
trap 'stop_lanes; exit 130' INT TERM

while [ "${#lanes[@]}" -gt 0 ]; do
    set +e
    wait -n -p pid "${!lanes[@]}"
    status=$?
    set -e
    lane=${lanes[$pid]}
    unset "lanes[$pid]"

    if [ "$status" -ne 0 ]; then
        trap - INT TERM
        stop_lanes
        failed "$lane"
    fi

    echo "    $lane passed ($(elapsed))"
done
trap - INT TERM
rm -f "$LOGS"/*.pid

# Nothing changed while they ran, or the note would be of something else.
if dirty || [ "$(git rev-parse HEAD)" != "$HEAD_SHA" ]; then
    fail 'the code changed while the gates ran; run bin/verify again.'
fi

touch "$NOTES/$HEAD_SHA"
step "All gates passed for $(git rev-parse --short HEAD) in $(elapsed)"
