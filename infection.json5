{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        // Paths are relative to the source directories above.
        "excludes": [
            "Shared/Kernel.php",
            "Shared/Migrations",
            "Shared/Twig",
            "Shared/Ui"
        ]
    },
    "mutators": {
        "@default": true,
        // Controllers compose their page from Twig components in a private
        // page() method. That composition is checked by the ui-check harness,
        // not by PHPUnit, so mutating its arrays only yields unkillable mutants.
        // The rest of the controller keeps every mutator.
        "ArrayItem": {
            "ignore": ["*\\Controller\\*::page"]
        },
        "ArrayItemRemoval": {
            "ignore": ["*\\Controller\\*::page"]
        },
        "TrueValue": {
            "ignore": ["*\\Controller\\*::page"]
        }
    },
    "timeout": 60,
    "threads": "auto",
    "minMsi": 70,
    "minCoveredMsi": 80,
    "ignoreMsiWithNoMutations": true,
    // Infection does not quote paths containing spaces in its generated
    // commands, so this working directory lives outside the project path.
    "tmpDir": "/tmp/infection-blog-autista",
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log",
        "json": "var/infection/infection.json"
    },
    "phpUnit": {
        "configDir": "."
    }
}
