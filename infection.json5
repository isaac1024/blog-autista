{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        // Paths are relative to the source directories above.
        "excludes": [
            // The kernel only boots Symfony with the bundles and the
            // configuration it finds: there is no logic of the site in it.
            "Shared/Infrastructure/Kernel.php",
            // Migrations are generated by Doctrine and run once against the
            // database; the schema they leave is checked by
            // doctrine:schema:validate, not by tests mutating them.
            "Shared/Infrastructure/Persistence/Doctrine/Migrations"
        ]
    },
    "mutators": {
        "@default": true,
        // Twig writes every prop a component doesn't mount to the public
        // property of its name, so hiding a mount() that only assigns them
        // changes nothing. A mount() that decides more, such as Panel's, is
        // tested for what it refuses and works out, whatever calls it.
        "PublicVisibility": {
            "ignore": ["Shared\\Infrastructure\\Twig\\Components\\*::mount"]
        },
        // Every kind of block has its arm, so the default one is never
        // reached; PHPStan asks for it, as it can't tell the match is whole.
        "MatchArmRemoval": {
            "ignore": ["Shared\\Infrastructure\\Ui\\RichTextComponents::block"]
        },
        // A Doctrine type takes mixed and must refuse a PHP value of another
        // type, but Doctrine only ever hands it what the column holds, a
        // string, or what the entity maps, so no repository reaches the
        // refusal. Nor does one reach a column that is no JSON: every JSON
        // column has a json_valid check, so the database refuses it first.
        // What a repository can reach, a JSON value of the wrong shape, is
        // tested by reading a corrupt row back.
        "ArrayItemRemoval": {
            "ignoreSourceCodeByRegex": ["throw InvalidType::new\\(.+"]
        },
        "Throw_": {
            "ignoreSourceCodeByRegex": [
                "throw InvalidType::new\\(.+",
                "throw ValueNotConvertible::new\\(\\$value, self::class, \\$exception->getMessage\\(\\), \\$exception\\);"
            ]
        }
    },
    "timeout": 60,
    "threads": "auto",
    "minMsi": 70,
    "minCoveredMsi": 80,
    "ignoreMsiWithNoMutations": true,
    // Infection does not quote paths containing spaces in its generated
    // commands, so this working directory lives outside the project path.
    "tmpDir": "/tmp/infection-blog-autista",
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log",
        "json": "var/infection/infection.json"
    },
    "phpUnit": {
        "configDir": "."
    }
}
