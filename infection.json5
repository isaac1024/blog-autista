{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        // Paths are relative to the source directories above.
        "excludes": [
            "Shared/Infrastructure/Kernel.php",
            "Shared/Infrastructure/Persistence/Doctrine/Migrations",
            "Shared/Infrastructure/Twig",
            "Shared/Infrastructure/Ui"
        ]
    },
    "mutators": {
        "@default": true,
        // Controllers compose their page from Twig components in page() and
        // the private methods that build its parts. That composition is
        // checked by the ui-check harness, not by PHPUnit, so mutating it only
        // yields unkillable mutants. The action that handles the request keeps
        // every mutator.
        "global-ignore": [
            "*\\Controller\\*::page",
            "*\\Controller\\*::row",
            "*\\Controller\\*::address",
            "*\\Controller\\*::slugField",
            "*\\Controller\\*::homeAddress",
            "*\\Controller\\*::searchEngineSection",
            "*\\Controller\\*::pageActions",
            "*\\Controller\\*::formActions",
            "*\\Controller\\*::confirmModal",
            "*\\Controller\\*::uploadModal",
            "*\\Controller\\*::imageActions",
            "*\\Controller\\*::titleField",
            "*\\Controller\\*::dates",
            "*\\Controller\\*::images"
        ]
    },
    "timeout": 60,
    "threads": "auto",
    "minMsi": 70,
    "minCoveredMsi": 80,
    "ignoreMsiWithNoMutations": true,
    // Infection does not quote paths containing spaces in its generated
    // commands, so this working directory lives outside the project path.
    "tmpDir": "/tmp/infection-blog-autista",
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log",
        "json": "var/infection/infection.json"
    },
    "phpUnit": {
        "configDir": "."
    }
}
