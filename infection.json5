{
    "$schema": "vendor/infection/infection/resources/schema.json",
    "source": {
        "directories": [
            "src"
        ],
        // Paths are relative to the source directories above.
        "excludes": [
            "Shared/Infrastructure/Kernel.php",
            "Shared/Infrastructure/Persistence/Doctrine/Migrations",
            "Shared/Infrastructure/Twig",
            "Shared/Infrastructure/Ui"
        ]
    },
    "mutators": {
        "@default": true,
        // Controllers that still compose their page from Twig components, in
        // page() and the private methods that build its parts, leave that
        // composition to the ui-check harness, not to PHPUnit, so mutating it
        // only yields unkillable mutants. The action that handles the request
        // keeps every mutator. A composer taken out of its controller is
        // tested for what it decides and held to the contract of the
        // components it composes, so nothing of it is ignored.
        "global-ignore": [
            "*\\Controller\\*::page"
        ]
    },
    "timeout": 60,
    "threads": "auto",
    "minMsi": 70,
    "minCoveredMsi": 80,
    "ignoreMsiWithNoMutations": true,
    // Infection does not quote paths containing spaces in its generated
    // commands, so this working directory lives outside the project path.
    "tmpDir": "/tmp/infection-blog-autista",
    "logs": {
        "text": "var/infection/infection.log",
        "summary": "var/infection/summary.log",
        "json": "var/infection/infection.json"
    },
    "phpUnit": {
        "configDir": "."
    }
}
