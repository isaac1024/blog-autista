{
  "name": "blog-autista",
  "private": true,
  "type": "module",
  "description": "UI quality gates (HTML, performance and accessibility) for the blog.autista frontend.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "ui:check": "node tools/ui-check.mjs",
