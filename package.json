{
  "name": "blog-autista",
  "private": true,
  "type": "module",
  "description": "UI quality gates (HTML, CSS, performance and accessibility) for the blog.autista frontend.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "tailwind:build": "tailwindcss -i assets/styles/app.css -o public/styles/tailwind.css --minify",
    "tailwind:watch": "tailwindcss -i assets/styles/app.css -o public/styles/tailwind.css --watch --poll=500",
    "ui:check": "node tools/ui-check.mjs",
    "ui:html": "node tools/ui-check.mjs --only=html",
    "ui:css": "node tools/ui-check.mjs --only=css",
    "ui:contrast": "node tools/ui-check.mjs --only=contrast",
    "ui:lighthouse": "node tools/ui-check.mjs --only=lighthouse"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.6.0",
    "tailwindcss": "^4.3.3",
    "vnu-jar": "^26.10.12"
  }
}
