{
  "name": "blog-autista",
  "private": true,
  "type": "module",
  "description": "Browser interaction tests and UI quality gates for the blog.autista frontend.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:js": "npm run lint:js && npm run typecheck:js && npm run test:js",
    "check:js:full": "npm run check:js && npm run mutation:js",
    "lint:js": "eslint assets tests/Browser tests/Markup tests/Unit tools stryker.config.mjs playwright.config.js eslint.config.js",
    "typecheck:js": "tsc -p jsconfig.json",
    "test:js": "npm run test:unit && npm run test:browser",
    "test:unit": "node --test tests/Unit",
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "test:browser:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium",
    "mutation:js": "stryker run",
    "ui:check": "node tools/ui-check.mjs",
    "ui:html": "node tools/ui-check.mjs --only=html",
    "ui:contrast": "node tools/ui-check.mjs --only=contrast",
    "ui:lighthouse": "node tools/ui-check.mjs --only=lighthouse"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hotwired/stimulus": "3.2.2",
    "@playwright/test": "^1.65.0",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/tap-runner": "10.1.1",
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-blockquote": "3.34.0",
    "@tiptap/extension-bold": "3.34.0",
    "@tiptap/extension-document": "3.34.0",
    "@tiptap/extension-heading": "3.34.0",
    "@tiptap/extension-list": "3.34.0",
    "@tiptap/extension-paragraph": "3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-text": "3.34.0",
    "@tiptap/extensions": "3.34.0",
    "@tiptap/pm": "3.34.0",
    "@tiptap/suggestion": "3.34.0",
    "chrome-launcher": "^1.2.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "happy-dom": "21.0.4",
    "lighthouse": "^13.6.0",
    "typescript": "^7.0.2",
    "vnu-jar": "^26.10.12"
  }
}
