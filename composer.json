{
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.5",
        "ext-ctype": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-pdo_mysql": "*",
        "ext-redis": "*",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/doctrine-migrations-bundle": "^4.0",
        "doctrine/orm": "^3.7",
        "imagine/imagine": "^1.5",
        "nelmio/security-bundle": "^3.9",
        "symfony/apache-pack": "^1.0",
        "symfony/asset": "8.1.*",
        "symfony/asset-mapper": "8.1.*",
        "symfony/clock": "8.1.*",
        "symfony/console": "8.1.*",
        "symfony/doctrine-messenger": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/filesystem": "8.1.*",
        "symfony/flex": "^2",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/intl": "8.1.*",
        "symfony/lock": "8.1.*",
        "symfony/messenger": "8.1.*",
        "symfony/rate-limiter": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/scheduler": "8.1.*",
        "symfony/security-bundle": "8.1.*",
        "symfony/serializer": "8.1.*",
        "symfony/stimulus-bundle": "^3.6",
        "symfony/translation": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/uid": "8.1.*",
        "symfony/ux-twig-component": "^3.6",
        "symfony/yaml": "8.1.*",
        "symfonycasts/tailwind-bundle": "^1.0"
    },
    "require-dev": {
        "brianium/paratest": "^7.27",
        "dama/doctrine-test-bundle": "^8.7",
        "friendsofphp/php-cs-fixer": "^3.95",
        "infection/infection": "^0.35.8",
        "phpat/phpat": "^0.12.5",
        "phpmd/phpmd": "^3.0",
        "phpstan/phpstan": "^2.3",
        "phpstan/phpstan-doctrine": "^2.1",
        "phpstan/phpstan-phpunit": "^2.1",
        "phpstan/phpstan-strict-rules": "^2.1",
        "phpstan/phpstan-symfony": "^2.1",
        "phpunit/phpunit": "^13.4",
        "shipmonk/dead-code-detector": "^1.4",
        "symfony/browser-kit": "8.1.*",
        "symfony/css-selector": "8.1.*",
        "vincentlanglet/twig-cs-fixer": "^4.1"
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true,
            "symfony/flex": true,
            "symfony/runtime": true,
            "infection/extension-installer": true
        },
        "bump-after-update": true,
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Web\\": "src/Web/",
            "Cms\\": "src/Cms/",
            "Shared\\": "src/Shared/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Web\\Tests\\": "tests/Web/",
            "Cms\\Tests\\": "tests/Cms/",
            "Shared\\Tests\\": "tests/Shared/"
        }
    },
    "replace": {
        "symfony/polyfill-ctype": "*",
        "symfony/polyfill-iconv": "*",
        "symfony/polyfill-php72": "*",
        "symfony/polyfill-php73": "*",
        "symfony/polyfill-php74": "*",
        "symfony/polyfill-php80": "*",
        "symfony/polyfill-php81": "*",
        "symfony/polyfill-php82": "*",
        "symfony/polyfill-php83": "*",
        "symfony/polyfill-php84": "*"
    },
    "scripts": {
        "auto-scripts": {
            "cache:clear": "symfony-cmd",
            "assets:install %PUBLIC_DIR%": "symfony-cmd",
            "importmap:install": "symfony-cmd"
        },
        "post-install-cmd": [
            "@auto-scripts"
        ],
        "post-update-cmd": [
            "@auto-scripts"
        ],
        "cs": "php-cs-fixer fix",
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "twig:cs": "twig-cs-fixer fix",
        "twig:cs:check": "twig-cs-fixer lint",
        "stan": [
            "bin/console cache:warmup --env=dev",
            "phpstan analyse --memory-limit=1G"
        ],
        "complexity": "phpmd analyze src --ruleset phpmd.xml --exclude '*Migrations*' --cache --cache-file var/phpmd.result-cache.php --no-progress",
        "schema": "bin/console doctrine:schema:validate",
        "test": "paratest",
        "test:serial": "phpunit",
        "check:ui": "node tools/ui-check.mjs",
        "infection": "XDEBUG_MODE=coverage php -d memory_limit=-1 vendor/bin/infection --with-uncovered",
        "infection:diff": "XDEBUG_MODE=coverage infection --with-uncovered --git-diff-lines --git-diff-base=master",
        "check": [
            "@cs:check",
            "@twig:cs:check",
            "@complexity",
            "@stan",
            "@schema",
            "@test"
        ],
        "check:full": [
            "@check",
            "@infection"
        ]
    },
    "conflict": {
        "symfony/symfony": "*"
    },
    "extra": {
        "symfony": {
            "allow-contrib": true,
            "require": "8.1.*"
        }
    }
}
